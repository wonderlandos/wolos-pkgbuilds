# SPDX-License-Identifier: GPL-2.0-or-later
# wopkg: one package tool for every source (ADR 0021). The Crystal CLI (wopkg/) on libwopkg
# (crates/wopkg, stable C ABI, libwopkg.so.1), built from github.com/wonderlandos/wolos; shell completions and the
# official recipes ship with it.
pkgname=wopkg
pkgver=0.1.0  # wopkg/shard.yml at _wolos_commit
pkgrel=8
pkgdesc='WolOS package tool: pacman repos, Flatpak, AppImage, recipes and community packages in one command'
arch=(x86_64)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
depends=(gc pcre2 openssl zlib gcc-libs glibc bubblewrap git gnupg libarchive)
optdepends=('flatpak: Flatpak apps' 'base-devel: building AUR packages' 'wolos-system: malware check of third-party downloads' 'strace: system-call trace of AUR builds')
makedepends=(cargo crystal git)
options=(!debug !lto)
# The WolOS source at one commit (bumped by bump-wolos.sh from wolos CI), with its submodules.
_wolos_commit=11cd053405c386404b3d811d842fb82b361209ab
# The submodule commits recorded in wolos at _wolos_commit (bump-wolos.sh keeps them in step).
_brand_commit=6c6d2c0511b8d1427d81929d537113e71e7be737
_shell_commit=b72d6806e8939ceb218ec0190707a381515a22a4
source=("wolos::git+https://github.com/wonderlandos/wolos.git#commit=$_wolos_commit"
  "wolos-brand::git+https://github.com/wonderlandos/wolos-brand.git#commit=$_brand_commit"
  "wolos-shell::git+https://github.com/wonderlandos/wolos-shell.git#commit=$_shell_commit")
sha256sums=(SKIP SKIP SKIP)

prepare() {
  cd "$srcdir/wolos"
  git submodule init
  git config submodule.design.url "$srcdir/wolos-brand"
  git config submodule.crates/shell.url "$srcdir/wolos-shell"
  git -c protocol.file.allow=always submodule update
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  local _repo=$srcdir/wolos _j
  cd "$_repo"
  # The jobs makepkg was given (MAKEFLAGS -jN, or wolos-build's CARGO_BUILD_JOBS), else every core.
  case " ${MAKEFLAGS:-} " in *' -j'[0-9]*) _j=${MAKEFLAGS##*-j}; _j=${_j%% *} ;; *) _j=$(nproc) ;; esac
  # sccache when the build has it (wolos-build binds SCCACHE_DIR in): cached rustc calls across builds.
  if command -v sccache >/dev/null && [ -z "${RUSTC_WRAPPER:-}" ]; then export RUSTC_WRAPPER=sccache; fi
  CARGO_TARGET_DIR=$srcdir/target cargo build -p wopkg -p aurlaws --release --locked -j"${CARGO_BUILD_JOBS:-$_j}"
  crates/wopkg/link.sh "$srcdir/target/release/libwopkg.a" "$srcdir/lib"
  cd wopkg
  crystal build --release --no-debug src/wopkg.cr -o "$srcdir/wopkg" --link-flags "-L$srcdir/lib"
  for s in zsh bash fish; do LD_LIBRARY_PATH=$srcdir/lib "$srcdir/wopkg" completions $s > "$srcdir/wopkg.$s"; done
  if [ "${RUSTC_WRAPPER:-}" = sccache ]; then sccache --show-stats || true; fi
}

check() {
  local _repo=$srcdir/wolos
  cd "$_repo/wopkg"
  crystal spec --link-flags "-L$srcdir/lib -Wl,-rpath,$srcdir/lib"
}

package() {
  local _repo=$srcdir/wolos
  install -Dm755 "$srcdir/wopkg" "$pkgdir/usr/bin/wopkg"
  install -Dm755 "$srcdir/target/release/wopkg-aurlaws" "$pkgdir/usr/bin/wopkg-aurlaws"
  install -Dm755 "$srcdir/lib/libwopkg.so.1" "$pkgdir/usr/lib/libwopkg.so.1"
  ln -s libwopkg.so.1 "$pkgdir/usr/lib/libwopkg.so"
  install -Dm644 "$_repo/crates/wopkg/include/wopkg.h" "$pkgdir/usr/include/wopkg.h"
  install -Dm644 "$srcdir/wopkg.zsh" "$pkgdir/usr/share/zsh/site-functions/_wopkg"
  install -Dm644 "$srcdir/wopkg.bash" "$pkgdir/usr/share/bash-completion/completions/wopkg"
  install -Dm644 "$srcdir/wopkg.fish" "$pkgdir/usr/share/fish/vendor_completions.d/wopkg.fish"
  local r
  for r in "$_repo"/wopkg/recipes/*/recipe.toml; do
    install -Dm644 "$r" "$pkgdir/usr/share/wopkg/recipes/$(basename "$(dirname "$r")")/recipe.toml"
  done
  (cd "$_repo/wopkg" && LD_LIBRARY_PATH=$srcdir/lib "$srcdir/wopkg" recipe index recipes) > "$pkgdir/usr/share/wopkg/recipes/index.json"
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
