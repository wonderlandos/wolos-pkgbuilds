# SPDX-License-Identifier: GPL-2.0-or-later
# libwol: the WolOS app API behind a stable C ABI (ADR 0020), libwol.so.1 and wol.h, built from
# crates/wol-abi of github.com/wonderlandos/wolos. Apps in any language link it: C, the Cryswol
# shard (Crystal, ADR 0036), Swift and .NET. The exports and symbol versions come only from
# crates/wol-abi/abi/wol.map (link.sh), the soname is the ABI major.
pkgname=libwol
pkgver=1.16.0  # WOL_VERSION_MAJOR.MINOR.PATCH of crates/wol-abi/include/wol.h at _wolos_commit
pkgrel=1
pkgdesc='WolOS app API: libwol.so.1 and wol.h, the stable C ABI apps in every language link'
arch=(x86_64)
url='https://github.com/wonderlandos/wolos'
# libwol is BSD-2-Clause (crates/wol-abi, shared, core); the statically linked Rust crates it
# carries are BSD-3-Clause, MIT or Apache-2.0.
license=(BSD-2-Clause BSD-3-Clause MIT Apache-2.0)
depends=(gcc-libs glibc)
provides=(libwol.so)
makedepends=(cargo git)
options=(!debug !lto)
# The WolOS source at one commit (bumped by bump-wolos.sh from wolos CI), with its submodules
# (cargo reads every workspace member, crates/shell included).
_wolos_commit=95fc996ad0b587b805ffe8d2a07e4964f86e26dd
# The submodule commits recorded in wolos at _wolos_commit (bump-wolos.sh keeps them in step).
_brand_commit=eada74b6bad5fc51140bfaf4db4d86d47b8cdaa9
_shell_commit=cf8d1687204456f5dbaf282c994e8934bf85b34d
source=("wolos::git+https://github.com/wonderlandos/wolos.git#commit=$_wolos_commit"
  "wolos-brand::git+https://github.com/wonderlandos/wolos-brand.git#commit=$_brand_commit"
  "wolos-shell::git+https://github.com/wonderlandos/wolos-shell.git#commit=$_shell_commit")
sha256sums=(SKIP SKIP SKIP)

prepare() {
  cd "$srcdir/wolos"
  git submodule init
  git config submodule.design.url "$srcdir/wolos-brand"
  git config submodule.crates/shell.url "$srcdir/wolos-shell"
  git -c protocol.file.allow=always submodule update
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  local _repo=$srcdir/wolos _j
  cd "$_repo"
  # The jobs makepkg was given (MAKEFLAGS -jN, or wolos-build's CARGO_BUILD_JOBS), else every core.
  case " ${MAKEFLAGS:-} " in *' -j'[0-9]*) _j=${MAKEFLAGS##*-j}; _j=${_j%% *} ;; *) _j=$(nproc) ;; esac
  # sccache when the build has it (wolos-build binds SCCACHE_DIR in): cached rustc calls across builds.
  if command -v sccache >/dev/null && [ -z "${RUSTC_WRAPPER:-}" ]; then export RUSTC_WRAPPER=sccache; fi
  CARGO_TARGET_DIR=$srcdir/target cargo build -p wol-abi --release --locked -j"${CARGO_BUILD_JOBS:-$_j}"
  # The shared object from the staticlib: wol.map alone decides what is exported.
  crates/wol-abi/link.sh "$srcdir/target/release/libwol.a" "$srcdir/lib"
  if [ "${RUSTC_WRAPPER:-}" = sccache ]; then sccache --show-stats || true; fi
}

check() {
  local _repo=$srcdir/wolos
  cd "$_repo"
  # The ABI promise (every shipped symbol, version node and declaration still there) and the C
  # programs against fake wold and Kit hosts. The language bindings run in the wolos CI.
  CARGO_TARGET_DIR=$srcdir/target cargo test -p wol-abi --release --locked \
    --test abi --test c_hello --test c_menus --test c_services
}

package() {
  local _repo=$srcdir/wolos
  install -Dm755 "$srcdir/lib/libwol.so.1" "$pkgdir/usr/lib/libwol.so.1"
  ln -s libwol.so.1 "$pkgdir/usr/lib/libwol.so"
  install -Dm644 "$_repo/crates/wol-abi/include/wol.h" "$pkgdir/usr/include/wol.h"
  install -Dm644 "$_repo/LICENSES/BSD-2-Clause.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
