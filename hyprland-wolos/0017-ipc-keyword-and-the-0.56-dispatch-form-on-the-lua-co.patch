+// WolOS 0017: keys resolve through the compositor's keycode resolver (any layout, held modifiers ignored:
+// patch 0006), the same as the Lua send_shortcut / send_key_state dispatchers.
+static SDispatchResult sendshortcut(const std::string& args) {
+    CVarList2 ARGS(args, 3);
+    if (ARGS.size() != 3)
+        return {.success = false, .error = "sendshortcut: invalid args"};
+
+    const auto MOD     = Keybinds::modMaskFromString(std::string(ARGS[0]));
+    const auto KEYCODE = Keybinds::resolver()->resolveKeycode(std::string(ARGS[1]));
+    if (!KEYCODE)
+        return {.success = false, .error = std::format("sendshortcut: {}", KEYCODE.error())};
+
+    const std::string regexp  = std::string(ARGS[2]);
+    PHLWINDOW         PWINDOW = regexp.empty() ? nullptr : Desktop::viewState()->query().selector(regexp).runWindow();
+
+    if (!regexp.empty() && !PWINDOW)
+        return {.success = false, .error = "sendshortcut: window not found"};
+
+    return wrap(Actions::pass(MOD, *KEYCODE, PWINDOW ? std::optional<PHLWINDOW>{PWINDOW} : std::nullopt));
+}
+
+static SDispatchResult sendkeystate(const std::string& args) {
+    CVarList2 ARGS(args, 4);
+    if (ARGS.size() != 4)
+        return {.success = false, .error = "sendkeystate: invalid args"};
+
+    const auto STATE = ARGS[2];
+    if (STATE != "down" && STATE != "repeat" && STATE != "up")
+        return {.success = false, .error = "sendkeystate: invalid state, must be 'down', 'repeat', or 'up'"};
+    const uint32_t keyState = STATE == "down" ? 1 : STATE == "repeat" ? 2 : 0;
+
+    const auto     MOD     = Keybinds::modMaskFromString(std::string(ARGS[0]));
+    const auto     KEYCODE = Keybinds::resolver()->resolveKeycode(std::string(ARGS[1]));
+    if (!KEYCODE)
+        return {.success = false, .error = std::format("sendkeystate: {}", KEYCODE.error())};
+
+    const std::string regexp  = std::string(ARGS[3]);
+    PHLWINDOW         PWINDOW = regexp.empty() ? nullptr : Desktop::viewState()->query().selector(regexp).runWindow();
+    if (!regexp.empty() && !PWINDOW)
+        return {.success = false, .error = "sendkeystate: window not found"};
+
+    return wrap(Actions::sendKeyState(MOD, *KEYCODE, keyState, PWINDOW ? std::optional<PHLWINDOW>{PWINDOW} : std::nullopt));
+}
