diff --git a/tests/helpers/WolosCompat.cpp b/tests/helpers/WolosCompat.cpp
new file mode 100644
index 0000000..532ffcf
--- /dev/null
+++ b/tests/helpers/WolosCompat.cpp
@@ -0,0 +1,58 @@
+#include <helpers/WolosCompat.hpp>
+
+#include <gtest/gtest.h>
+
+using namespace WolosCompat;
+
+TEST(WolosCompat, optionsBecomeTypedConfigCalls) {
+    EXPECT_EQ(*keywordToLua("decoration:rounding", "4"), R"lua(hl.config({ ["decoration.rounding"] = 4 }))lua");
+    EXPECT_EQ(*keywordToLua("decoration:blur:enabled", "false"), R"lua(hl.config({ ["decoration.blur.enabled"] = false }))lua");
+    EXPECT_EQ(*keywordToLua("cursor:zoom_factor", "3.000000"), R"lua(hl.config({ ["cursor.zoom_factor"] = 3.000000 }))lua");
+    EXPECT_EQ(*keywordToLua("plugin:hyprbars:bar_color", "rgba(112233e6)"), R"lua(hl.config({ ["plugin.hyprbars.bar_color"] = "rgba(112233e6)" }))lua");
+    EXPECT_EQ(*keywordToLua("plugin:hyprbars:col.text", "rgba(4c4f69ff)"), R"lua(hl.config({ ["plugin.hyprbars.col.text"] = "rgba(4c4f69ff)" }))lua");
+    EXPECT_EQ(*keywordToLua("input:kb_variant", ""), R"lua(hl.config({ ["input.kb_variant"] = "" }))lua");
+    EXPECT_EQ(*keywordToLua("input:touchpad:tap-to-click", "true"), R"lua(hl.config({ ["input.touchpad.tap_to_click"] = true }))lua");
+    EXPECT_EQ(*keywordToLua("general:col.active_border", "rgba(33ccffff) rgba(00ff99ee) 45deg"),
+              R"lua(hl.config({ ["general.col.active_border"] = { colors = { "rgba(33ccffff)", "rgba(00ff99ee)" }, angle = 45 } }))lua");
+    EXPECT_EQ(*keywordToLua("decoration:shadow:offset", "0 8"), R"lua(hl.config({ ["decoration.shadow.offset"] = "0 8" }))lua");
+    EXPECT_EQ(luaValue("1e3"), R"lua("1e3")lua");
+    EXPECT_EQ(luaValue("-40"), "-40");
+    EXPECT_EQ(luaStr("a\"b\\c\nd"), R"lua("a\"b\\c\nd")lua");
+    EXPECT_FALSE(keywordToLua("hl.config({})", "x").has_value());
+}
+
+TEST(WolosCompat, bindsCallTheLegacyDispatcher) {
+    EXPECT_EQ(*keywordToLua("bind", "SUPER,Space,exec,foot"), R"lua(hl.bind("SUPER + Space", function() hl.legacy_dispatch("exec", "foot") end))lua");
+    EXPECT_EQ(*keywordToLua("binde", "SUPER CTRL,left,resizeactive,-40 0"),
+              R"lua(hl.bind("SUPER + CTRL + left", function() hl.legacy_dispatch("resizeactive", "-40 0") end, { repeating = true }))lua");
+    EXPECT_EQ(*keywordToLua("bindrt", "SUPER, SUPER_R, exec, wol shell hide switcher"),
+              R"lua(hl.bind("SUPER + SUPER_R", function() hl.legacy_dispatch("exec", "wol shell hide switcher") end, { release = true, transparent = true }))lua");
+    EXPECT_EQ(*keywordToLua("bindn", ", Escape, exec, wol shell hide transient"),
+              R"lua(hl.bind("Escape", function() hl.legacy_dispatch("exec", "wol shell hide transient") end, { non_consuming = true }))lua");
+    EXPECT_EQ(*keywordToLua("bind", "SUPER ALT,left,movefocus,l"), R"lua(hl.bind("SUPER + ALT + left", function() hl.legacy_dispatch("movefocus", "l") end))lua");
+    EXPECT_EQ(*keywordToLua("bind", "SUPERSHIFT, K, exec, a, b"), R"lua(hl.bind("SUPER + SHIFT + K", function() hl.legacy_dispatch("exec", "a, b") end))lua");
+    EXPECT_EQ(*keywordToLua("bindm", "SUPER, mouse:272, movewindow"), R"lua(hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true }))lua");
+    EXPECT_EQ(*keywordToLua("unbind", "SUPER ALT,left"), R"lua(hl.unbind("SUPER + ALT + left"))lua");
+    EXPECT_FALSE(keywordToLua("bindd", "SUPER, Q, Quit, exec, x").has_value());
+    EXPECT_FALSE(keywordToLua("bind", "SUPER").has_value());
+}
+
+TEST(WolosCompat, animationsAndNamedRules) {
+    EXPECT_EQ(*keywordToLua("animation", "windowsIn,1,4.4,wolOut,popin 90%"),
+              R"lua(hl.animation({ leaf = "windowsIn", enabled = true, speed = 4.4, bezier = "wolOut", style = "popin 90%" }))lua");
+    EXPECT_EQ(*keywordToLua("windowrule[wol-float]:enable", "false"), R"lua(hl.window_rule({ name = "wol-float", enabled = false }))lua");
+    EXPECT_EQ(*keywordToLua("windowrule[wol-float-apps]:match:class", "^(mpv)$"), R"lua(hl.window_rule({ name = "wol-float-apps", match = { ["class"] = "^(mpv)$" } }))lua");
+}
+
+TEST(WolosCompat, dispatchTellsLegacyFromLua) {
+    auto known = [](const std::string& n) { return n == "exec" || n == "workspace" || n == "closewindow" || n == "exit"; };
+    auto d     = legacyDispatch("exec pgrep -x wol-lock || wol-lock", known);
+    ASSERT_TRUE(d.has_value());
+    EXPECT_EQ(d->name, "exec");
+    EXPECT_EQ(d->arg, "pgrep -x wol-lock || wol-lock");
+    EXPECT_EQ(legacyDispatch("workspace 3", known)->arg, "3");
+    EXPECT_EQ(legacyDispatch("exit", known)->arg, "");
+    EXPECT_FALSE(legacyDispatch("hl.dsp.exit()", known).has_value());
+    EXPECT_FALSE(legacyDispatch("hl.dsp.exec_cmd(\"foot\")", known).has_value());
+    EXPECT_FALSE(legacyDispatch("nosuch 1", known).has_value());
+}
