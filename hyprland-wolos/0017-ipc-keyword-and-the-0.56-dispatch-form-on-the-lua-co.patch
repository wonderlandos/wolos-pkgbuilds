+// WolOS 0017: `keyword NAME VALUE` (0.56) as the Lua call it means, run like `eval`.
+static std::string keywordRequest(eHyprCtlOutputFormat format, std::string in) {
+    if (Config::mgr()->type() != Config::CONFIG_LUA)
+        return "keyword is only supported with the lua config manager";
+
+    in               = in.substr(in.find_first_of(' ') + 1);
+    const auto SPACE = in.find_first_of(' ');
+    const auto NAME  = in.substr(0, SPACE);
+    const auto VALUE = SPACE == std::string::npos ? std::string{} : in.substr(SPACE + 1);
+    const auto LUA   = WolosCompat::keywordToLua(NAME, VALUE);
+    if (!LUA)
+        return std::format("keyword: {} has no Lua form", NAME);
+
+    auto luaMgr = dynamicPointerCast<Config::Lua::CConfigManager>(WP<Config::IConfigManager>(Config::mgr()));
+    if (const auto ERR = luaMgr->eval(*LUA))
+        return *ERR;
+    return "ok";
+}
