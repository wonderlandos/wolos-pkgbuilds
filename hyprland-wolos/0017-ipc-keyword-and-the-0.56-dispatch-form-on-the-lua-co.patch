+            return wrap(Actions::renameWorkspace(PWS, name));
+        } else {
+            const auto PWS = findWorkspace(std::to_string(std::stoi(args)));
+            if (!PWS)
+                return {.success = false, .error = "No such workspace"};
+            return wrap(Actions::renameWorkspace(PWS, ""));
