diff --git a/src/helpers/WolosCompat.hpp b/src/helpers/WolosCompat.hpp
new file mode 100644
index 0000000..ffe3c79
--- /dev/null
+++ b/src/helpers/WolosCompat.hpp
@@ -0,0 +1,244 @@
+#pragma once
+
+// WolOS compatibility layer (patch 0017): the 0.56 IPC forms the WolOS tools send, on the 0.57 Lua
+// configuration. `hyprctl keyword NAME VALUE` becomes one Lua chunk run like `hyprctl eval`;
+// `hyprctl dispatch NAME ARGS` with a 0.56 dispatcher name runs that dispatcher. Pure functions:
+// tested in tests/helpers/WolosCompat.cpp.
+
+#include <cctype>
+#include <cstdint>
+#include <format>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace WolosCompat {
+    inline std::string_view trim(std::string_view s) {
+        while (!s.empty() && std::isspace((unsigned char)s.front()))
+            s.remove_prefix(1);
+        while (!s.empty() && std::isspace((unsigned char)s.back()))
+            s.remove_suffix(1);
+        return s;
+    }
+
+    // A Lua string literal: double quotes, `\`, `"` and control characters escaped.
+    inline std::string luaStr(std::string_view s) {
+        std::string out = "\"";
+        for (const char c : s) {
+            if (c == '\\')
+                out += "\\\\";
+            else if (c == '"')
+                out += "\\\"";
+            else if (c == '\n')
+                out += "\\n";
+            else if ((unsigned char)c < 0x20 || c == 0x7f)
+                out += std::format("\\{:03}", (int)(unsigned char)c);
+            else
+                out += c;
+        }
+        return out + "\"";
+    }
+
+    // A decimal number as Lua reads it (digits, one leading '-', one '.'): not "1e3", "inf", "0x10".
+    inline bool isPlainNumber(std::string_view s) {
+        if (!s.empty() && s.front() == '-')
+            s.remove_prefix(1);
+        if (s.empty() || s.front() == '.' || s.back() == '.')
+            return false;
+        int dots = 0;
+        for (const char c : s) {
+            if (c == '.')
+                dots++;
+            else if (!std::isdigit((unsigned char)c))
+                return false;
+        }
+        return dots <= 1;
+    }
+
+    // The literal an option of any type takes: true/false, a number, a gradient table
+    // (`rgba(..) rgba(..) 45deg`) or a string (colours, vectors "0 8", names).
+    inline std::string luaValue(std::string_view raw) {
+        const auto v = trim(raw);
+        if (v == "true" || v == "false" || isPlainNumber(v))
+            return std::string{v};
+        // gradient: two or more colours, an optional angle
+        std::vector<std::string_view> parts;
+        size_t                        i = 0;
+        while (i < v.size()) {
+            const auto j = v.find(' ', i);
+            const auto p = v.substr(i, j == std::string_view::npos ? std::string_view::npos : j - i);
+            if (!p.empty())
+                parts.push_back(p);
+            if (j == std::string_view::npos)
+                break;
+            i = j + 1;
+        }
+        bool gradient = parts.size() > 1;
+        for (const auto& p : parts)
+            gradient = gradient && (p.starts_with("rgb") || p.starts_with("0x") || p.ends_with("deg"));
+        if (gradient) {
+            std::string colors, angle;
+            for (const auto& p : parts) {
+                if (p.ends_with("deg"))
+                    angle = std::format(", angle = {}", p.substr(0, p.size() - 3));
+                else
+                    colors += (colors.empty() ? "" : ", ") + luaStr(p);
+            }
+            return std::format("{{ colors = {{ {} }}{} }}", colors, angle);
+        }
+        return luaStr(v);
+    }
+
+    // "SUPER SHIFT", "SUPER_SHIFT" or "SUPERSHIFT" and a key as `hl.bind` reads them: "SUPER + SHIFT + Z".
+    inline std::string bindKeys(std::string_view mods, std::string_view key) {
+        static constexpr std::string_view NAMES[] = {"SUPER", "SHIFT", "CTRL", "CONTROL", "ALT", "MOD2", "MOD3", "MOD5", "META", "WIN", "LOGO", "MOD4", "MOD1", "CAPS"};
+        std::string                       out;
+        std::string                       up;
+        for (const char c : mods)
+            up += (char)std::toupper((unsigned char)c);
+        size_t i = 0;
+        while (i < up.size()) {
+            if (up[i] == ' ' || up[i] == '_' || up[i] == '+') {
+                i++;
+                continue;
+            }
+            bool hit = false;
+            for (const auto n : NAMES) {
+                if (std::string_view{up}.substr(i).starts_with(n)) {
+                    out += std::string{n} + " + ";
+                    i += n.size();
+                    hit = true;
+                    break;
+                }
+            }
+            if (!hit)
+                return {}; // not a modifier list
+        }
+        return out + std::string{trim(key)};
+    }
+
+    // Splits "a, b, c, rest, with, commas" into at most `n` fields (the last keeps its commas).
+    inline std::vector<std::string> fields(std::string_view s, size_t n) {
+        std::vector<std::string> out;
+        while (out.size() + 1 < n) {
+            const auto c = s.find(',');
+            if (c == std::string_view::npos)
+                break;
+            out.emplace_back(trim(s.substr(0, c)));
+            s.remove_prefix(c + 1);
+        }
+        out.emplace_back(trim(s));
+        return out;
+    }
+
+    // `bind` flag letters as hl.bind options.
+    inline std::optional<std::string> bindOptions(std::string_view flags) {
+        std::string out;
+        for (const char c : flags) {
+            const char* opt = nullptr;
+            switch (c) {
+                case 'e': opt = "repeating"; break;
+                case 'l': opt = "locked"; break;
+                case 'r': opt = "release"; break;
+                case 'n': opt = "non_consuming"; break;
+                case 'm': opt = "mouse"; break;
+                case 't': opt = "transparent"; break;
+                case 'i': opt = "ignore_mods"; break;
+                case 'o': opt = "long_press"; break;
+                default: return std::nullopt; // `d` (description) and others: not kept
+            }
+            out += std::format("{}{} = true", out.empty() ? "" : ", ", opt);
+        }
+        return out;
+    }
+
+    // `hyprctl keyword NAME VALUE` as one Lua chunk; nullopt when it has no Lua form here.
+    inline std::optional<std::string> keywordToLua(std::string_view name, std::string_view value) {
+        name  = trim(name);
+        value = trim(value);
+        if (name.starts_with("bind")) {
+            const auto flags = name.substr(4);
+            for (const char c : flags)
+                if (!std::islower((unsigned char)c))
+                    return std::nullopt;
+            const auto opts = bindOptions(flags);
+            const auto f    = fields(value, 4);
+            if (!opts || f.size() < 3)
+                return std::nullopt;
+            const auto keys = bindKeys(f[0], f[1]);
+            if (keys.empty() && !trim(f[0]).empty())
+                return std::nullopt;
+            const std::string KEYS = luaStr(keys.empty() ? f[1] : keys);
+            const std::string ARG  = f.size() > 3 ? f[3] : "";
+            std::string       action;
+            if (flags.find('m') != std::string_view::npos && f[2] == "movewindow")
+                action = "hl.dsp.window.drag()";
+            else if (flags.find('m') != std::string_view::npos && f[2] == "resizewindow")
+                action = "hl.dsp.window.resize()";
+            else
+                action = std::format("function() hl.legacy_dispatch({}, {}) end", luaStr(f[2]), luaStr(ARG));
+            return opts->empty() ? std::format("hl.bind({}, {})", KEYS, action) : std::format("hl.bind({}, {}, {{ {} }})", KEYS, action, *opts);
+        }
+        if (name == "unbind") {
+            const auto f    = fields(value, 2);
+            const auto keys = f.size() == 2 ? bindKeys(f[0], f[1]) : std::string{};
+            if (f.size() != 2 || (keys.empty() && !trim(f[0]).empty()))
+                return std::nullopt;
+            return std::format("hl.unbind({})", luaStr(keys.empty() ? f[1] : keys));
+        }
+        if (name == "animation") {
+            const auto f = fields(value, 5);
+            if (f.size() < 2)
+                return std::nullopt;
+            std::string s = std::format("hl.animation({{ leaf = {}, enabled = {}", luaStr(f[0]), f[1] == "1" ? "true" : "false");
+            if (f.size() > 2)
+                s += std::format(", speed = {}", luaValue(f[2]));
+            if (f.size() > 3)
+                s += std::format(", bezier = {}", luaStr(f[3]));
+            if (f.size() > 4)
+                s += std::format(", style = {}", luaStr(f[4]));
+            return s + " })";
+        }
+        if (name.starts_with("windowrule[") || name.starts_with("layerrule[")) {
+            const bool window = name.starts_with("windowrule[");
+            const auto close  = name.find("]:");
+            const auto open   = name.find('[');
+            if (close == std::string_view::npos)
+                return std::nullopt;
+            const auto rule = name.substr(open + 1, close - open - 1);
+            const auto prop = name.substr(close + 2);
+            const auto fn   = window ? "hl.window_rule" : "hl.layer_rule";
+            if (prop == "enable" || prop == "enabled")
+                return std::format("{}({{ name = {}, enabled = {} }})", fn, luaStr(rule), value == "true" || value == "1" ? "true" : "false");
+            if (prop.starts_with("match:"))
+                return std::format("{}({{ name = {}, match = {{ [{}] = {} }} }})", fn, luaStr(rule), luaStr(prop.substr(6)), luaStr(value));
+            return std::format("{}({{ name = {}, [{}] = {} }})", fn, luaStr(rule), luaStr(prop), luaValue(value));
+        }
+        if (name.empty() || name.find_first_of(" (){}[]\"'=") != std::string_view::npos)
+            return std::nullopt;
+        std::string key{name};
+        for (auto& c : key) {
+            if (c == ':')
+                c = '.';
+            else if (c == '-')
+                c = '_';
+        }
+        return std::format("hl.config({{ [{}] = {} }})", luaStr(key), luaValue(value));
+    }
+
+    // `hyprctl dispatch` text: the 0.56 form (a dispatcher name, then its argument) when the first
+    // word is one, else Lua (`hl.dsp.…`, a function).
+    struct SLegacyDispatch {
+        std::string name, arg;
+    };
+    template <typename KNOWN>
+    inline std::optional<SLegacyDispatch> legacyDispatch(std::string_view in, KNOWN&& known) {
+        in               = trim(in);
+        const auto SPACE = in.find(' ');
+        const auto NAME  = in.substr(0, SPACE);
+        if (NAME.empty() || NAME.find_first_of("().{}\"'") != std::string_view::npos || !known(std::string{NAME}))
+            return std::nullopt;
+        return SLegacyDispatch{std::string{NAME}, SPACE == std::string_view::npos ? std::string{} : std::string{trim(in.substr(SPACE + 1))}};
+    }
+}
