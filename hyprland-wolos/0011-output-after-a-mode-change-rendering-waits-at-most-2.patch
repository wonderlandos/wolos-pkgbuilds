From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:51:21 -0300
Subject: [PATCH] output: after a mode change, rendering waits at most 250 ms
 for clients to ack their new size

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/desktop/view/window/WaylandBackend.hpp |  4 ++++
 src/helpers/WolosPerf.hpp                  | 28 ++++++++++++++++++++++
 src/output/Monitor.cpp                     |  3 +++
 src/output/Monitor.hpp                     |  3 +++
 src/render/Renderer.cpp                    | 28 ++++++++++++++++++++++
 tests/helpers/WolosPerf.cpp                | 16 +++++++++++++
 6 files changed, 82 insertions(+)

diff --git a/src/desktop/view/window/WaylandBackend.hpp b/src/desktop/view/window/WaylandBackend.hpp
index ee0c966..1ce5717 100644
--- a/src/desktop/view/window/WaylandBackend.hpp
+++ b/src/desktop/view/window/WaylandBackend.hpp
@@ -42,6 +42,10 @@ namespace Desktop::View {
         void                   restackToTop() override;
         void                   close() override;
         void                   ping() override;
+        // WolOS: configures the client has not acked yet (the post-mode-change wait).
+        bool                   awaitingConfigureAcks() const {
+            return !m_configureAcks.empty();
+        }
 
       private:
         void                       attach(PHLWINDOWREF window) override;
diff --git a/src/helpers/WolosPerf.hpp b/src/helpers/WolosPerf.hpp
index 32b89b2..25f20f2 100644
--- a/src/helpers/WolosPerf.hpp
+++ b/src/helpers/WolosPerf.hpp
@@ -7,6 +7,9 @@
 #include <vector>
 
 namespace WolosPerf {
+    inline double nowMs() {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
     // Slow safety tick for the cursor-hiding check (was a fixed 2 Hz poll).
     inline constexpr int CURSOR_HEARTBEAT_MS = 5000;
 
@@ -128,4 +131,29 @@ namespace WolosPerf {
         st.skipped++;
         return false;
     }
+
+    // Output reconfigure barrier: after a mode change, rendering waits for clients to ack their new size,
+    // but never longer than `timeoutMs`.
+    struct SReconfigureBarrier {
+        bool   active  = false;
+        double startMs = 0;
+
+        void   begin(double nowMs) {
+            active  = true;
+            startMs = nowMs;
+        }
+        // True while the render should still wait. Releases itself when nobody is pending or the time is up.
+        bool hold(double nowMs, int pendingClients, double timeoutMs) {
+            if (!active)
+                return false;
+            if (pendingClients <= 0 || timeoutMs <= 0 || nowMs - startMs >= timeoutMs) {
+                active = false;
+                return false;
+            }
+            return true;
+        }
+        double remainingMs(double nowMs, double timeoutMs) const {
+            return std::max(1.0, timeoutMs - (nowMs - startMs));
+        }
+    };
 }
diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index caf4209..aff1444 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -1027,6 +1027,9 @@ bool CMonitor::applyMonitorRule(Config::CMonitorRule&& pMonitorRule) {
 
     m_events.modeChanged.emit();
 
+    if (OLD_PIXEL_SIZE != m_pixelSize)
+        m_wolosReconfigure.begin(WolosPerf::nowMs());
+
     return true;
 }
 
diff --git a/src/output/Monitor.hpp b/src/output/Monitor.hpp
index c37e48c..0cad871 100644
--- a/src/output/Monitor.hpp
+++ b/src/output/Monitor.hpp
@@ -4,6 +4,7 @@
 #include <stack>
 #include <vector>
 #include "../SharedDefs.hpp"
+#include "../helpers/WolosPerf.hpp"
 #include "../helpers/MiscFunctions.hpp"
 #include "../helpers/WLClasses.hpp"
 #include <array>
@@ -118,6 +119,8 @@ namespace Monitor {
 
         SP<CEventLoopTimer>         m_dpmsRetryTimer;
 
+        WolosPerf::SReconfigureBarrier m_wolosReconfigure;
+        SP<CEventLoopTimer>         m_wolosReconfigureTimer;
         bool                        m_pendingFrame    = false; // if we schedule a frame during rendering, reschedule it after
         bool                        m_renderingActive = false;
 
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index 305fea5..66838f0 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -88,6 +88,7 @@ using namespace Render;
 
 extern "C" {
 #include <xf86drm.h>
+#include "../desktop/view/window/WaylandBackend.hpp"
 
 // WolOS: a window that clients can see (0.56 IView::aliveAndVisible): mapped, not hidden, a mapped
 // surface and some alpha. Used by the covered-window throttle and the post-mode-change ack wait.
@@ -2284,6 +2285,33 @@ void IHyprRenderer::renderMonitor(PHLMONITOR pMonitor, bool commit) {
         return;
     }
 
+    // After a mode change, give clients up to misc:reconfigure_ack_timeout_ms to ack their resized surfaces.
+    if (pMonitor->m_wolosReconfigure.active) {
+        static auto PACKMS = CConfigValue<Config::INTEGER>("misc:reconfigure_ack_timeout_ms");
+        int         pending = 0;
+        for (const auto& w : Desktop::windowState()->windows())
+            if (wolosShown(w) && w->m_monitor == pMonitor && w->backend().type() == Desktop::View::eBackendType::WINDOW_BACKEND_WAYLAND &&
+                static_cast<const Desktop::View::CWaylandBackend&>(w->backend()).awaitingConfigureAcks())
+                pending++;
+        const double NOWMS = WolosPerf::nowMs();
+        if (pMonitor->m_wolosReconfigure.hold(NOWMS, pending, *PACKMS)) {
+            // a client commit schedules a frame too; the timer guarantees one at the deadline
+            if (!pMonitor->m_wolosReconfigureTimer || !pMonitor->m_wolosReconfigureTimer->armed()) {
+                if (pMonitor->m_wolosReconfigureTimer)
+                    g_pEventLoopManager->removeTimer(pMonitor->m_wolosReconfigureTimer);
+                pMonitor->m_wolosReconfigureTimer = makeShared<CEventLoopTimer>(
+                    std::chrono::milliseconds(sc<int>(pMonitor->m_wolosReconfigure.remainingMs(NOWMS, *PACKMS))),
+                    [mon = PHLMONITORREF{pMonitor}](SP<CEventLoopTimer>, void*) {
+                        if (mon)
+                            mon->scheduleFrame();
+                    },
+                    nullptr);
+                g_pEventLoopManager->addTimer(pMonitor->m_wolosReconfigureTimer);
+            }
+            return;
+        }
+    }
+
     if (!*PDAMAGEBLINK)
         damageBlinkCleanup = 0;
 
diff --git a/tests/helpers/WolosPerf.cpp b/tests/helpers/WolosPerf.cpp
index 1e747d9..51880da 100644
--- a/tests/helpers/WolosPerf.cpp
+++ b/tests/helpers/WolosPerf.cpp
@@ -109,3 +109,19 @@ TEST(WolosPerf, throttleNeedsManyWindowsAndLowVisibility) {
     c.enabled = false;
     EXPECT_TRUE(allowFrameCallback(st, 0.0, 20, 1.0, c));
 }
+
+TEST(WolosPerf, reconfigureWaitsForAcksButNeverPast250ms) {
+    SReconfigureBarrier b;
+    EXPECT_FALSE(b.hold(0, 3, 250)); // nothing started
+    b.begin(1000);
+    EXPECT_TRUE(b.hold(1010, 2, 250));
+    EXPECT_TRUE(b.hold(1249, 1, 250));
+    EXPECT_FALSE(b.hold(1250, 1, 250)); // timed out
+    EXPECT_FALSE(b.hold(1251, 1, 250)); // stays released
+    b.begin(2000);
+    EXPECT_FALSE(b.hold(2005, 0, 250)); // all clients acked
+    b.begin(3000);
+    EXPECT_FALSE(b.hold(3001, 5, 0));   // timeout 0 disables waiting
+    b.begin(4000);
+    EXPECT_DOUBLE_EQ(b.remainingMs(4100, 250), 150.0);
+}
