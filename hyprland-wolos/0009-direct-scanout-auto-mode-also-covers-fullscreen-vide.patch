From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kleeedolinux <71413974+kleeedolinux@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:07:14 -0300
Subject: [PATCH] direct-scanout: auto mode also covers fullscreen video and
 tearing-hint games

Upstream auto scans out content-type game only; browser video and Proton games kept a composite pass.
---
 src/helpers/WolosPerf.hpp   | 5 +++++
 src/output/Monitor.cpp      | 3 ++-
 tests/helpers/WolosPerf.cpp | 6 ++++++
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/helpers/WolosPerf.hpp b/src/helpers/WolosPerf.hpp
index f3e0397..520d6a9 100644
--- a/src/helpers/WolosPerf.hpp
+++ b/src/helpers/WolosPerf.hpp
@@ -38,4 +38,9 @@ namespace WolosPerf {
     inline bool layerCommitDirtiesBlur(int layer, bool fullDamage, bool hasSurfaceDamage) {
         return layer <= 1 && (fullDamage || hasSurfaceDamage);
     }
+    // render:direct_scanout = 2 scans out fullscreen games (upstream: content-type game only), video players
+    // (content-type video) and windows that asked for tearing (games without a content type, e.g. Proton).
+    inline bool autoScanoutAllows(bool contentGame, bool contentVideo, bool tearingHint) {
+        return contentGame || contentVideo || tearingHint;
+    }
 }
diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index 7775fca..caf4209 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -1,3 +1,4 @@
+#include "../helpers/WolosPerf.hpp"
 #include "Monitor.hpp"
 #include "../desktop/view/window/WindowEffectsController.hpp"
 #include "../desktop/view/window/WindowPresentation.hpp"
@@ -1925,7 +1926,7 @@ uint16_t CMonitor::isDSBlocked(bool full) {
             reasons |= DS_BLOCK_WINDOWED;
             if (!full)
                 return reasons;
-        } else if (FSWINDOW->getContentType() != CONTENT_TYPE_GAME) {
+        } else if (!WolosPerf::autoScanoutAllows(FSWINDOW->getContentType() == CONTENT_TYPE_GAME, FSWINDOW->getContentType() == CONTENT_TYPE_VIDEO, sc<bool>(FSWINDOW->m_hints & Desktop::View::WINDOW_HINT_TEAR))) {
             reasons |= DS_BLOCK_CONTENT;
             if (!full)
                 return reasons;
diff --git a/tests/helpers/WolosPerf.cpp b/tests/helpers/WolosPerf.cpp
index 3aae3a8..cf35417 100644
--- a/tests/helpers/WolosPerf.cpp
+++ b/tests/helpers/WolosPerf.cpp
@@ -44,3 +44,9 @@ TEST(WolosPerf, blurCacheSurvivesQuietBackdropCommits) {
     EXPECT_FALSE(layerCommitDirtiesBlur(2, true, true));   // top layers are not in the blur cache
 }
 
+TEST(WolosPerf, autoScanoutCoversGamesAndVideo) {
+    EXPECT_TRUE(autoScanoutAllows(true, false, false));   // wp_content_type game
+    EXPECT_TRUE(autoScanoutAllows(false, true, false));   // mpv, browser fullscreen video
+    EXPECT_TRUE(autoScanoutAllows(false, false, true));   // Proton game: tearing hint, no content type
+    EXPECT_FALSE(autoScanoutAllows(false, false, false)); // a fullscreen editor keeps composition
+}
