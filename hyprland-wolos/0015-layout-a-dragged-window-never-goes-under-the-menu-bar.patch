From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:00:00 -0300
Subject: [PATCH] layout: a dragged window never goes under the menu bar and
 keeps 40 px on screen

Dragging a floating window (Super+drag, the hyprbars title bar, touch) could
put its title bar under the menu bar's reserved area or push the whole window
off screen, where nothing could reach it again. macOS clamps the frame top to
the usable area and keeps part of the window on every edge.

CDragStateController::mouseMove clamps the new position after snapping:
WolosWindow::clampDragY keeps the frame top (client y minus the bar reserved
above it, hyprbars) at or below the zone top and 40 px of the frame above the
Dock; clampDragX keeps 40 px inside horizontally. Pure functions, gtest in
tests/helpers/WolosWindow.cpp. Resizing is untouched.

---
 src/helpers/WolosWindow.hpp                 | 20 ++++++++++++++++++++
 src/layout/supplementary/DragController.cpp | 13 +++++++++++++
 tests/helpers/WolosWindow.cpp               | 17 +++++++++++++++++
 3 files changed, 50 insertions(+)

--- a/src/layout/supplementary/DragController.cpp
+++ b/src/layout/supplementary/DragController.cpp
@@ -13,6 +13,7 @@
 #include "../../protocols/XDGShell.hpp"
 #include "../../render/Renderer.hpp"
 #include "../../state/MonitorState.hpp"
+#include "../../helpers/WolosWindow.hpp"
 
 #include <string_view>
 
@@ -367,6 +368,18 @@
         if (*SNAPENABLED && !m_draggingTiled)
             g_layoutManager->performSnap(newPos, newSize, DRAGGINGTARGET, MBIND_MOVE, -1, m_beginDragSizeXY);
 
+        // WolOS: a floating window is never dragged under the menu bar (or any reserved area above
+        // the usable zone) and keeps DRAG_KEEP px on screen (macOS). The bar reserved above the
+        // client area (hyprbars) is the frame top. WolosWindow.hpp, tested in tests/helpers.
+        if (!m_draggingTiled && TRACKMOTION && DRAGGINGTARGET->floating()) {
+            if (const auto PMONITOR = MOTIONWINDOW->m_monitor.lock()) {
+                const auto ZONE = PMONITOR->logicalBoxMinusReserved();
+                const auto BAR  = MOTIONWINDOW->getWindowExtentsUnified(Desktop::View::RESERVED_EXTENTS).topLeft.y;
+                newPos.x        = WolosWindow::clampDragX(newPos.x, newSize.x, ZONE.x, ZONE.w);
+                newPos.y        = WolosWindow::clampDragY(newPos.y, BAR, ZONE.y, ZONE.h);
+            }
+        }
+
         newPos = newPos.round();
 
         DRAGGINGTARGET->setPositionGlobal({newPos, newSize});
--- a/src/helpers/WolosWindow.hpp
+++ b/src/helpers/WolosWindow.hpp
@@ -2,9 +2,30 @@
 
 // WolOS window policy (macOS behaviour). Pure functions: tested in tests/helpers/WolosWindow.cpp.
 
+#include <algorithm>
 #include <string_view>
 
 namespace WolosWindow {
+    // Pixels of a dragged window's frame that always stay inside the usable area (macOS: a window
+    // can be pushed mostly off screen, never out of reach).
+    inline constexpr double DRAG_KEEP = 40;
+
+    // Dragging (pointer or touch) never puts the title bar under the menu bar: the frame top
+    // (client y minus the bar reserved above it) stays at or below the usable area's top, and at
+    // least DRAG_KEEP px of the frame stay above the area's bottom (the Dock). Returns the client y.
+    inline double clampDragY(double clientY, double barHeight, double zoneY, double zoneH) {
+        const double top    = clientY - barHeight;
+        const double lowest = std::max(zoneY, zoneY + zoneH - DRAG_KEEP);
+        return std::clamp(top, zoneY, lowest) + barHeight;
+    }
+
+    // Horizontally at least DRAG_KEEP px of the window stay inside the usable area.
+    inline double clampDragX(double x, double width, double zoneX, double zoneW) {
+        const double leftmost  = zoneX + DRAG_KEEP - width;
+        const double rightmost = std::max(leftmost, zoneX + zoneW - DRAG_KEEP);
+        return std::clamp(x, leftmost, rightmost);
+    }
+
     // Where minimise parks windows (xdg set_minimized, the shell's Minimise and Hide items).
     inline constexpr std::string_view HIDDEN = "special:hidden";
 
--- a/tests/helpers/WolosWindow.cpp
+++ b/tests/helpers/WolosWindow.cpp
@@ -10,3 +10,20 @@
     EXPECT_FALSE(restoresOnFocus(false, "special:hidden"));    // a regular workspace with that name
     EXPECT_FALSE(restoresOnFocus(false, "1"));
 }
+
+// 1280x720 output, 28 px menu bar and 102 px Dock reserved: zone y 28, h 590. Title bar 28 px.
+TEST(WolosWindow, dragNeverPutsTheTitleBarUnderTheMenuBar) {
+    EXPECT_DOUBLE_EQ(clampDragY(300, 28, 28, 590), 300);    // inside: untouched
+    EXPECT_DOUBLE_EQ(clampDragY(40, 28, 28, 590), 28 + 28); // frame top at the zone top
+    EXPECT_DOUBLE_EQ(clampDragY(-500, 28, 28, 590), 56);
+    EXPECT_DOUBLE_EQ(clampDragY(2000, 28, 28, 590), 28 + 590 - 40 + 28); // 40 px of frame above the Dock
+    EXPECT_DOUBLE_EQ(clampDragY(100, 0, 28, 590), 100);     // no bar (CSD window): client top is the frame top
+    EXPECT_DOUBLE_EQ(clampDragY(0, 0, 28, 20), 28);         // zone shorter than DRAG_KEEP: pinned to its top
+}
+
+TEST(WolosWindow, dragKeepsFortyPixelsOfTheWindowOnScreen) {
+    EXPECT_DOUBLE_EQ(clampDragX(300, 400, 0, 1280), 300);
+    EXPECT_DOUBLE_EQ(clampDragX(-1000, 400, 0, 1280), 40 - 400); // 40 px remain at the left edge
+    EXPECT_DOUBLE_EQ(clampDragX(5000, 400, 0, 1280), 1280 - 40); // and at the right edge
+    EXPECT_DOUBLE_EQ(clampDragX(0, 400, 1280, 20), 1280 + 40 - 400); // zone narrower than DRAG_KEEP: leftmost wins
+}
