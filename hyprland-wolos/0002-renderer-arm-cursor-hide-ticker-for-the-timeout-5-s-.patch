From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Mon, 26 Oct 2026 02:43:24 -0300
Subject: [PATCH] renderer: arm cursor-hide ticker for the timeout, 5 s
 heartbeat otherwise

The cursor-hide ticker polled at a fixed 2 Hz. It now sleeps until
cursor:inactive_timeout can fire, or a 5 s heartbeat without a timeout or while
the pointer is hidden. Pointer motion that unhides the cursor re-arms the
ticker, so the next hide is on time instead of up to 5 s late.
WolosPerf::cursorTickerDelayMs, gtest in tests/helpers/WolosPerf.cpp.
---
 src/render/Renderer.cpp     | 12 +++++++++++-
 src/render/Renderer.hpp     |  1 +
 tests/helpers/WolosPerf.cpp |  1 +
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index 4bbb606..d6d8f46 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -1,4 +1,5 @@
 #include "Renderer.hpp"
+#include "../helpers/WolosPerf.hpp"
 #include "../Compositor.hpp"
 #include "../helpers/math/Math.hpp"
 #include <algorithm>
@@ -91,7 +92,8 @@ extern "C" {
 
 static int cursorTicker(void* data) {
     g_pHyprRenderer->ensureCursorRenderingMode();
-    wl_event_source_timer_update(g_pHyprRenderer->m_cursorTicker, 500);
+    // WolOS: sleep until the inactivity timeout can fire (5 s heartbeat) instead of a fixed 2 Hz poll.
+    wl_event_source_timer_update(g_pHyprRenderer->m_cursorTicker, g_pHyprRenderer->cursorTickerDelayMs());
     return 0;
 }
 
@@ -165,6 +167,9 @@ IHyprRenderer::IHyprRenderer() {
         m_cursorHiddenConditions.hiddenOnTouch    = g_pInputManager->m_lastInputTouch;
         m_cursorHiddenConditions.hiddenOnTablet   = g_pInputManager->m_lastInputTablet;
         ensureCursorRenderingMode();
+        // WolOS: the ticker slept the 5 s heartbeat while the pointer was hidden; arm it for this timeout.
+        if (m_cursorTicker)
+            wl_event_source_timer_update(m_cursorTicker, cursorTickerDelayMs());
     });
 
     static auto P3 = Event::bus()->m_events.monitor.focused.listen([&](PHLMONITOR mon) {
@@ -3187,6 +3192,11 @@ void IHyprRenderer::setCursorFromName(const std::string& name, bool force) {
     Pointer::Cursor::mgr()->setCursorFromName(name);
 }
 
+int IHyprRenderer::cursorTickerDelayMs() {
+    static auto PCURSORTIMEOUT = CConfigValue<Config::FLOAT>("cursor:inactive_timeout");
+    return WolosPerf::cursorTickerDelayMs(*PCURSORTIMEOUT, m_cursorHiddenConditions.hiddenOnTimeout, g_pInputManager->m_lastCursorMovement.getSeconds());
+}
+
 void IHyprRenderer::ensureCursorRenderingMode() {
     static auto PINVISIBLE     = CConfigValue<Config::INTEGER>("cursor:invisible");
     static auto PCURSORTIMEOUT = CConfigValue<Config::FLOAT>("cursor:inactive_timeout");
diff --git a/src/render/Renderer.hpp b/src/render/Renderer.hpp
index a5307fa..cf62a74 100644
--- a/src/render/Renderer.hpp
+++ b/src/render/Renderer.hpp
@@ -104,6 +104,7 @@ namespace Render {
         bool                            shouldRenderWindow(PHLWINDOW);
         bool                            shouldRenderMonitor(PHLMONITOR);
         void                            ensureCursorRenderingMode();
+        int                                 cursorTickerDelayMs();
         bool                            shouldRenderCursor();
         void                            setCursorHidden(bool hide);
 
diff --git a/tests/helpers/WolosPerf.cpp b/tests/helpers/WolosPerf.cpp
index a316596..20b9b89 100644
--- a/tests/helpers/WolosPerf.cpp
+++ b/tests/helpers/WolosPerf.cpp
@@ -24,6 +24,7 @@ TEST(WolosPerf, cursorTickerSleepsUntilTimeout) {
         {3.F, false, 1.F, 2001},                 // wake right after the deadline
         {3.F, false, 2.99F, 50},                 // clamped minimum
         {3.F, true, 9.F, CURSOR_HEARTBEAT_MS},   // already hidden: movement event unhides
+        {3.F, false, 0.F, 3001},                 // re-armed by that movement: the next hide is on time
         {100.F, false, 0.F, CURSOR_HEARTBEAT_MS} // never sleep longer than the heartbeat
     };
     for (auto c : cases)
