From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Sun, 1 Nov 2026 14:00:00 -0300
Subject: [PATCH] session-lock: a dead locker leaves black while one can
 restore it; a new locker takes over

With misc:allow_session_lock_restore a supervisor (wol-lock, ADR 0012) brings a
new lock client after a crash. Hyprland drew its "lockscreen app died" page
from the moment the old client was gone (shallConsiderLockMissing is true
without a lock object, whatever misc:lockdead_screen_delay says). The screen now
stays black, as for a --locked-cmd start; only a session with nothing that can
restore the lock still shows the page.

A new lock while the previous one never confirmed was ignored and waited
forever for locked or finished; with the option on it takes over.

Only /usr/bin/wol-lock may replace a held or pending lock (restore after a
crash, the --locked-cmd start, limbo). Upstream lets any same-user Wayland
client take over a locked session with the option on, and the new owner may
send unlock_and_destroy: a sandboxed app with the Wayland socket could unlock
the screen. Any other client asking then gets finished. A first lock on an
unlocked session is still anyone's. WolosLock::mayRestoreLock, refuseNewLock,
gtest in tests/helpers/WolosLock.cpp.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/helpers/WolosLock.hpp           | 33 +++++++++++++++++++++++++++++
 src/managers/SessionLockManager.cpp | 14 +++++++++++-
 src/protocols/SessionLock.cpp       |  4 ++++
 src/protocols/SessionLock.hpp       |  7 +++---
 src/render/Renderer.cpp             |  6 ++++--
 tests/helpers/WolosLock.cpp         | 26 +++++++++++++++++++++++
 6 files changed, 84 insertions(+), 6 deletions(-)

diff --git a/src/helpers/WolosLock.hpp b/src/helpers/WolosLock.hpp
index 20708d3..61fdfb7 100644
--- a/src/helpers/WolosLock.hpp
+++ b/src/helpers/WolosLock.hpp
@@ -1,6 +1,7 @@
 #pragma once
 
 #include <string>
+#include <string_view>
 #include <vector>
 
 // WolOS session-lock policy (ADR 0012). Pure functions: tested in tests/helpers/WolosLock.cpp.
@@ -25,6 +26,38 @@ namespace WolosLock {
         return sessionWasLocked;
     }
 
+    // Hyprland's "lockscreen app died" page. With misc:allow_session_lock_restore a supervisor brings a new lock
+    // client (wol-lock, ADR 0012): the screen stays black meanwhile, as for a `--locked-cmd` start. Only a session with
+    // nothing that can restore the lock still gets the page with its instructions.
+    inline constexpr bool showLockDead(bool startedLockedWithCmd, bool allowRestore) {
+        return !startedLockedWithCmd && !allowRestore;
+    }
+
+    // A new lock while the previous one never confirmed (limbo). Upstream ignores the newcomer, which then waits forever
+    // for `locked` or `finished`. With misc:allow_session_lock_restore the newcomer takes over.
+    inline constexpr bool newLockWaits(bool previousInLimbo, bool allowRestore) {
+        return previousInLimbo && !allowRestore;
+    }
+
+    // The only program that may take over a session that is already locked (or a lock in limbo): the WolOS
+    // supervisor and the lock screen it runs (ADR 0012). Any other same-user Wayland client, a sandboxed app
+    // included, could otherwise take the lock and send unlock_and_destroy.
+    inline constexpr std::string_view RESTORE_LOCKER = "/usr/bin/wol-lock";
+
+    // `exe` is the client's /proc/<pid>/exe ("... (deleted)" after the binary was updated in place).
+    inline bool mayRestoreLock(std::string_view exe) {
+        constexpr std::string_view DELETED = " (deleted)";
+        if (exe.ends_with(DELETED))
+            exe.remove_suffix(DELETED.size());
+        return exe == RESTORE_LOCKER;
+    }
+
+    // A new lock that would replace a held or pending one (crash restore, `--locked-cmd` start, limbo) is
+    // refused unless it comes from the restore locker. A first lock on an unlocked session is anyone's.
+    inline constexpr bool refuseNewLock(bool replacesALock, bool fromRestoreLocker) {
+        return replacesALock && !fromRestoreLocker;
+    }
+
     // start-hyprland after a crash: relaunch locked *with* the locker named in $WOLOS_CRASH_LOCK_CMD.
     // Upstream `--locked` alone leaves a locked screen with nothing that can unlock it.
     inline std::vector<std::string> crashLockArgs(const char* lockCmd) {
diff --git a/src/managers/SessionLockManager.cpp b/src/managers/SessionLockManager.cpp
index 01c5b12..fc293b7 100644
--- a/src/managers/SessionLockManager.cpp
+++ b/src/managers/SessionLockManager.cpp
@@ -11,6 +11,7 @@
 #include "../managers/eventLoop/EventLoopManager.hpp"
 #include "../state/MonitorState.hpp"
 #include "../helpers/WolosLock.hpp"
+#include "../helpers/MiscFunctions.hpp"
 #include <algorithm>
 #include <ranges>
 
@@ -53,13 +54,24 @@ CSessionLockManager::CSessionLockManager() {
 void CSessionLockManager::onNewSessionLock(SP<CSessionLock> pLock) {
     static auto PALLOWRELOCK = CConfigValue<Config::INTEGER>("misc:allow_session_lock_restore");
 
+    // WolOS: replacing a held or pending lock is for the restore locker only (wol-lock, ADR 0012).
+    const bool REPLACES = PROTO::sessionLock->isLocked() || (m_sessionLock && !clientDenied() && !clientLocked());
+    if (REPLACES) {
+        const auto EXE = binaryNameForWlClient(pLock->client());
+        if (WolosLock::refuseNewLock(true, EXE.has_value() && WolosLock::mayRestoreLock(*EXE))) {
+            LOG(Log::WARN, "Refusing a session lock takeover by {}: only {} may replace a lock", EXE.value_or("an unknown client"), WolosLock::RESTORE_LOCKER);
+            pLock->sendDenied();
+            return;
+        }
+    }
+
     if (PROTO::sessionLock->isLocked() && !*PALLOWRELOCK && g_pCompositor->m_startLockedCommand.empty()) {
         LOG(Log::DEBUG, "Cannot re-lock, misc:allow_session_lock_restore is disabled");
         pLock->sendDenied();
         return;
     }
 
-    if (m_sessionLock && !clientDenied() && !clientLocked())
+    if (WolosLock::newLockWaits(m_sessionLock && !clientDenied() && !clientLocked(), *PALLOWRELOCK))
         return; // Not allowing to relock in case the old lock is still in a limbo
 
     LOG(Log::DEBUG, "Session got locked by {:x}", (uintptr_t)pLock.get());
diff --git a/src/protocols/SessionLock.cpp b/src/protocols/SessionLock.cpp
index c8868d7..e343a01 100644
--- a/src/protocols/SessionLock.cpp
+++ b/src/protocols/SessionLock.cpp
@@ -166,6 +166,10 @@ void CSessionLock::sendDenied() {
     m_resource->sendFinished();
 }
 
+wl_client* CSessionLock::client() {
+    return m_resource ? m_resource->client() : nullptr;
+}
+
 CSessionLockProtocol::CSessionLockProtocol(const wl_interface* iface, const int& ver, const std::string& name) : IWaylandProtocol(iface, ver, name) {
     ;
 }
diff --git a/src/protocols/SessionLock.hpp b/src/protocols/SessionLock.hpp
index 8563413..1a6a823 100644
--- a/src/protocols/SessionLock.hpp
+++ b/src/protocols/SessionLock.hpp
@@ -48,9 +48,10 @@ class CSessionLock {
     CSessionLock(SP<CExtSessionLockV1> resource_);
     ~CSessionLock();
 
-    bool good();
-    void sendLocked();
-    void sendDenied();
+    bool       good();
+    void       sendLocked();
+    void       sendDenied();
+    wl_client* client(); // WolOS: who asks for the lock (restore takeover check)
 
     struct {
         CSignalT<SP<CSessionLockSurface>> newLockSurface;
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index e1822fb..72db377 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -1,5 +1,6 @@
 #include "Renderer.hpp"
 #include "../helpers/WolosPerf.hpp"
+#include "../helpers/WolosLock.hpp"
 #include "../Compositor.hpp"
 #include "../helpers/math/Math.hpp"
 #include <algorithm>
@@ -1842,8 +1843,9 @@ void IHyprRenderer::renderSessionLockPrimer(CRenderContext& ctx, PHLMONITOR pMon
 }
 
 void IHyprRenderer::renderSessionLockMissing(CRenderContext& ctx, PHLMONITOR pMonitor) {
-    if (g_pCompositor->m_startLocked && !g_pCompositor->m_startLockedCommand.empty())
-        return;
+    static auto PALLOWRELOCK = CConfigValue<Config::INTEGER>("misc:allow_session_lock_restore");
+    if (!WolosLock::showLockDead(g_pCompositor->m_startLocked && !g_pCompositor->m_startLockedCommand.empty(), *PALLOWRELOCK))
+        return; // the primer's black stays until the new lock client draws
 
     const bool ANY_PRESENT = g_pSessionLockManager->anySessionLockSurfacesPresent();
 
diff --git a/tests/helpers/WolosLock.cpp b/tests/helpers/WolosLock.cpp
index e4cb1b1..b585ace 100644
--- a/tests/helpers/WolosLock.cpp
+++ b/tests/helpers/WolosLock.cpp
@@ -24,6 +24,32 @@ TEST(WolosLock, takeoverOnlyWhenAlreadyLocked) {
     EXPECT_FALSE(isTakeover(false));
 }
 
+TEST(WolosLock, aDeadLockerIsBlackWhileOneCanRestoreIt) {
+    EXPECT_TRUE(showLockDead(false, false));  // nothing can restore the lock: upstream page with instructions
+    EXPECT_FALSE(showLockDead(false, true));  // Super+L lock crashed, wol-lock respawns it: black
+    EXPECT_FALSE(showLockDead(true, false));  // --locked-cmd start (upstream already black)
+    EXPECT_FALSE(showLockDead(true, true));
+}
+
+TEST(WolosLock, aNewLockerTakesOverFromOneInLimbo) {
+    EXPECT_TRUE(newLockWaits(true, false)); // upstream
+    EXPECT_FALSE(newLockWaits(true, true));
+    EXPECT_FALSE(newLockWaits(false, false));
+    EXPECT_FALSE(newLockWaits(false, true));
+}
+
+TEST(WolosLock, onlyWolLockTakesOverALockedSession) {
+    EXPECT_TRUE(mayRestoreLock("/usr/bin/wol-lock"));
+    EXPECT_TRUE(mayRestoreLock("/usr/bin/wol-lock (deleted)")); // updated in place while running
+    EXPECT_FALSE(mayRestoreLock("/usr/bin/hyprlock"));
+    EXPECT_FALSE(mayRestoreLock("/home/u/.local/bin/wol-lock")); // same name elsewhere
+    EXPECT_FALSE(mayRestoreLock("/usr/bin/wol-lockx"));
+    EXPECT_FALSE(mayRestoreLock(""));
+    EXPECT_TRUE(refuseNewLock(true, false));   // a sandboxed app trying to replace the lock
+    EXPECT_FALSE(refuseNewLock(true, true));   // wol-lock restoring a crashed lock screen
+    EXPECT_FALSE(refuseNewLock(false, false)); // first lock on an unlocked session: anyone
+}
+
 TEST(WolosLock, crashRestartRelaunchesTheLocker) {
     using V = std::vector<std::string>;
     EXPECT_EQ(crashLockArgs("wol-lock --startup"), (V{"--locked-cmd", "wol-lock --startup"}));
