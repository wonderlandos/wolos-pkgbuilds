From e9a3127f7c7d26ec29859fbc7fcf4f469acbdb24 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Sun, 1 Nov 2026 14:00:00 -0300
Subject: [PATCH] session-lock: a dead locker leaves black while one can
 restore it; a new locker takes over

With misc:allow_session_lock_restore a supervisor (wol-lock, ADR 0012) brings a
new lock client after a crash. Hyprland drew its "lockscreen app died" page
from the moment the old client was gone (shallConsiderLockMissing is true
without a lock object, whatever misc:lockdead_screen_delay says). The screen now
stays black, as for a --locked-cmd start; only a session with nothing that can
restore the lock still shows the page.

A new lock while the previous one never confirmed was ignored and waited
forever for locked or finished; with the option on it takes over.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/helpers/WolosLock.hpp           | 13 +++++++++++++
 src/managers/SessionLockManager.cpp |  2 +-
 src/render/Renderer.cpp             |  6 ++++--
 tests/helpers/WolosLock.cpp         | 14 ++++++++++++++
 4 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/helpers/WolosLock.hpp b/src/helpers/WolosLock.hpp
index 20708d3..d444d47 100644
--- a/src/helpers/WolosLock.hpp
+++ b/src/helpers/WolosLock.hpp
@@ -25,6 +25,19 @@ namespace WolosLock {
         return sessionWasLocked;
     }
 
+    // Hyprland's "lockscreen app died" page. With misc:allow_session_lock_restore a supervisor brings a new lock
+    // client (wol-lock, ADR 0012): the screen stays black meanwhile, as for a `--locked-cmd` start. Only a session with
+    // nothing that can restore the lock still gets the page with its instructions.
+    inline constexpr bool showLockDead(bool startedLockedWithCmd, bool allowRestore) {
+        return !startedLockedWithCmd && !allowRestore;
+    }
+
+    // A new lock while the previous one never confirmed (limbo). Upstream ignores the newcomer, which then waits forever
+    // for `locked` or `finished`. With misc:allow_session_lock_restore the newcomer takes over.
+    inline constexpr bool newLockWaits(bool previousInLimbo, bool allowRestore) {
+        return previousInLimbo && !allowRestore;
+    }
+
     // start-hyprland after a crash: relaunch locked *with* the locker named in $WOLOS_CRASH_LOCK_CMD.
     // Upstream `--locked` alone leaves a locked screen with nothing that can unlock it.
     inline std::vector<std::string> crashLockArgs(const char* lockCmd) {
diff --git a/src/managers/SessionLockManager.cpp b/src/managers/SessionLockManager.cpp
index 67f4816..30211e9 100644
--- a/src/managers/SessionLockManager.cpp
+++ b/src/managers/SessionLockManager.cpp
@@ -59,7 +59,7 @@ void CSessionLockManager::onNewSessionLock(SP<CSessionLock> pLock) {
         return;
     }
 
-    if (m_sessionLock && !clientDenied() && !clientLocked())
+    if (WolosLock::newLockWaits(m_sessionLock && !clientDenied() && !clientLocked(), *PALLOWRELOCK))
         return; // Not allowing to relock in case the old lock is still in a limbo
 
     LOGM(Log::DEBUG, "Session got locked by {:x}", (uintptr_t)pLock.get());
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index 304d120..4f45f18 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -1,5 +1,6 @@
 #include "Renderer.hpp"
 #include "../helpers/WolosPerf.hpp"
+#include "../helpers/WolosLock.hpp"
 #include "../Compositor.hpp"
 #include "../helpers/math/Math.hpp"
 #include <algorithm>
@@ -1714,8 +1715,9 @@ void IHyprRenderer::renderSessionLockPrimer(PHLMONITOR pMonitor) {
 }
 
 void IHyprRenderer::renderSessionLockMissing(PHLMONITOR pMonitor) {
-    if (g_pCompositor->m_startLocked && !g_pCompositor->m_startLockedCommand.empty())
-        return;
+    static auto PALLOWRELOCK = CConfigValue<Config::INTEGER>("misc:allow_session_lock_restore");
+    if (!WolosLock::showLockDead(g_pCompositor->m_startLocked && !g_pCompositor->m_startLockedCommand.empty(), *PALLOWRELOCK))
+        return; // the primer's black stays until the new lock client draws
 
     const bool ANY_PRESENT = g_pSessionLockManager->anySessionLockSurfacesPresent();
 
diff --git a/tests/helpers/WolosLock.cpp b/tests/helpers/WolosLock.cpp
index e4cb1b1..c53d655 100644
--- a/tests/helpers/WolosLock.cpp
+++ b/tests/helpers/WolosLock.cpp
@@ -24,6 +24,20 @@ TEST(WolosLock, takeoverOnlyWhenAlreadyLocked) {
     EXPECT_FALSE(isTakeover(false));
 }
 
+TEST(WolosLock, aDeadLockerIsBlackWhileOneCanRestoreIt) {
+    EXPECT_TRUE(showLockDead(false, false));  // nothing can restore the lock: upstream page with instructions
+    EXPECT_FALSE(showLockDead(false, true));  // Super+L lock crashed, wol-lock respawns it: black
+    EXPECT_FALSE(showLockDead(true, false));  // --locked-cmd start (upstream already black)
+    EXPECT_FALSE(showLockDead(true, true));
+}
+
+TEST(WolosLock, aNewLockerTakesOverFromOneInLimbo) {
+    EXPECT_TRUE(newLockWaits(true, false)); // upstream
+    EXPECT_FALSE(newLockWaits(true, true));
+    EXPECT_FALSE(newLockWaits(false, false));
+    EXPECT_FALSE(newLockWaits(false, true));
+}
+
 TEST(WolosLock, crashRestartRelaunchesTheLocker) {
     using V = std::vector<std::string>;
     EXPECT_EQ(crashLockArgs("wol-lock --startup"), (V{"--locked-cmd", "wol-lock --startup"}));
-- 
2.56.0

