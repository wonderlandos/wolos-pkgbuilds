diff --git a/src/helpers/WolosPerf.hpp b/src/helpers/WolosPerf.hpp
index 520d6a9..32b89b2 100644
--- a/src/helpers/WolosPerf.hpp
+++ b/src/helpers/WolosPerf.hpp
@@ -4,6 +4,7 @@
 
 #include <algorithm>
 #include <chrono>
+#include <vector>
 
 namespace WolosPerf {
     // Slow safety tick for the cursor-hiding check (was a fixed 2 Hz poll).
@@ -43,4 +44,88 @@ namespace WolosPerf {
     inline bool autoScanoutAllows(bool contentGame, bool contentVideo, bool tearingHint) {
         return contentGame || contentVideo || tearingHint;
     }
+
+    // Surface frame throttling. A window that is (almost) fully covered, while many windows compete, only
+    // gets a frame callback every `freezeMs` or after `freezeUpdates` skipped opportunities, whichever is first.
+    struct SRect {
+        double x = 0, y = 0, w = 0, h = 0;
+    };
+    struct SThrottleConfig {
+        bool   enabled        = true;
+        int    windowCount    = 10;   // throttle only when MORE windows than this are mapped
+        double cutoff         = 0.2;  // visible fraction below this counts as occluded
+        double freezeMs       = 33.3; // longest stretch without a frame callback
+        int    freezeUpdates  = 2;    // longest run of skipped callbacks
+    };
+    struct SThrottleState {
+        double sinceSentMs = 1e9;
+        int    skipped     = 0;
+    };
+
+    // Fraction of `self` not covered by any rectangle in `above`. Coordinate-compressed grid: exact, O(n^3) for n occluders.
+    inline double visibleFraction(const SRect& self, const std::vector<SRect>& above) {
+        if (self.w <= 0 || self.h <= 0)
+            return 0;
+        std::vector<double> xs{self.x, self.x + self.w}, ys{self.y, self.y + self.h};
+        auto                clampx = [&](double v) { return std::clamp(v, self.x, self.x + self.w); };
+        auto                clampy = [&](double v) { return std::clamp(v, self.y, self.y + self.h); };
+        for (const auto& r : above) {
+            xs.push_back(clampx(r.x));
+            xs.push_back(clampx(r.x + r.w));
+            ys.push_back(clampy(r.y));
+            ys.push_back(clampy(r.y + r.h));
+        }
+        std::sort(xs.begin(), xs.end());
+        std::sort(ys.begin(), ys.end());
+        double visible = 0;
+        for (size_t i = 0; i + 1 < xs.size(); ++i) {
+            for (size_t j = 0; j + 1 < ys.size(); ++j) {
+                const double cx = (xs[i] + xs[i + 1]) / 2, cy = (ys[j] + ys[j + 1]) / 2;
+                if (xs[i + 1] <= xs[i] || ys[j + 1] <= ys[j])
+                    continue;
+                bool covered = false;
+                for (const auto& r : above)
+                    if (cx >= r.x && cx < r.x + r.w && cy >= r.y && cy < r.y + r.h) {
+                        covered = true;
+                        break;
+                    }
+                if (!covered)
+                    visible += (xs[i + 1] - xs[i]) * (ys[j + 1] - ys[j]);
+            }
+        }
+        return visible / (self.w * self.h);
+    }
+
+    // Under a fullscreen window only the windows Hyprland hides there count as covered: the fullscreen
+    // window itself, and whatever is allowed over it (dialogs, popups, pinned windows) keep their frames.
+    inline bool coveredByFullscreen(bool fullscreenOnWorkspace, bool isTheFullscreenWindow, bool allowedOverFullscreen) {
+        return fullscreenOnWorkspace && !isTheFullscreenWindow && !allowedOverFullscreen;
+    }
+
+    // What of a window covers the windows below it: its whole box when the client says the surface is opaque,
+    // else the extents of the opaque region it set (surface-local, logical), cut to the box. Rounded corners and
+    // CSD shadows make a surface non-opaque but leave the region over the content. Empty: covers nothing.
+    inline SRect occluderRect(const SRect& box, bool opaque, const SRect& opaqueExtents) {
+        if (opaque)
+            return box;
+        const double x0 = std::max(box.x, box.x + opaqueExtents.x), y0 = std::max(box.y, box.y + opaqueExtents.y);
+        const double x1 = std::min(box.x + box.w, box.x + opaqueExtents.x + opaqueExtents.w);
+        const double y1 = std::min(box.y + box.h, box.y + opaqueExtents.y + opaqueExtents.h);
+        if (opaqueExtents.w <= 0 || opaqueExtents.h <= 0 || x1 <= x0 || y1 <= y0)
+            return SRect{};
+        return SRect{x0, y0, x1 - x0, y1 - y0};
+    }
+
+    // True when the surface gets its frame callback now. `elapsedMs` is the time since the previous opportunity.
+    inline bool allowFrameCallback(SThrottleState& st, double visible, int mappedWindows, double elapsedMs, const SThrottleConfig& c) {
+        st.sinceSentMs += elapsedMs;
+        const bool throttled = c.enabled && mappedWindows > c.windowCount && visible < c.cutoff;
+        if (!throttled || st.sinceSentMs >= c.freezeMs || st.skipped >= c.freezeUpdates) {
+            st.sinceSentMs = 0;
+            st.skipped     = 0;
+            return true;
+        }
+        st.skipped++;
+        return false;
+    }
 }
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index d0a267e..305fea5 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -88,6 +88,13 @@ using namespace Render;
 
 extern "C" {
 #include <xf86drm.h>
+
+// WolOS: a window that clients can see (0.56 IView::aliveAndVisible): mapped, not hidden, a mapped
+// surface and some alpha. Used by the covered-window throttle and the post-mode-change ack wait.
+static bool wolosShown(const PHLWINDOW& w) {
+    const auto RES = w ? w->resource() : nullptr;
+    return RES && RES->m_mapped && w->mapped() && !w->isHidden() && w->alphaNonZero();
+}
 }
 
 static int cursorTicker(void* data) {
@@ -2787,6 +2794,29 @@ void IHyprRenderer::renderWorkspace(CRenderContext& ctx, PHLWORKSPACE workspace,
 }
 
 void IHyprRenderer::sendFrameEventsToWorkspace(PHLMONITOR pMonitor, PHLWORKSPACE pWorkspace, const Time::steady_tp& now) {
+    static auto PTHROTTLE   = CConfigValue<Config::INTEGER>("misc:throttle_occluded");
+    static auto PCOUNT      = CConfigValue<Config::INTEGER>("misc:throttle_window_count");
+    static auto PCUTOFF     = CConfigValue<Config::FLOAT>("misc:throttle_occlusion_cutoff");
+    static auto PFREEZEMS   = CConfigValue<Config::FLOAT>("misc:throttle_freeze_ms");
+    static auto PFREEZEUPD  = CConfigValue<Config::INTEGER>("misc:throttle_freeze_updates");
+
+    const WolosPerf::SThrottleConfig CFG{
+        .enabled = *PTHROTTLE, .windowCount = sc<int>(*PCOUNT), .cutoff = *PCUTOFF, .freezeMs = *PFREEZEMS, .freezeUpdates = sc<int>(*PFREEZEUPD)};
+
+    const auto                       elapsedMs = std::chrono::duration<double, std::milli>(now - m_wolosLastFrameEvents).count();
+    m_wolosLastFrameEvents                     = now;
+
+    // Windows in stacking order, bottom first: whatever comes after a window can cover it.
+    std::vector<PHLWINDOW> mapped;
+    for (const auto& w : Desktop::windowState()->windows())
+        if (wolosShown(w) && w->m_monitor == pMonitor)
+            mapped.emplace_back(w);
+    const int  COUNT = sc<int>(mapped.size());
+    const auto FS    = CFG.enabled && COUNT > CFG.windowCount ? Fullscreen::controller()->getFullscreenWindow(pWorkspace, true) : nullptr;
+
+    std::unordered_map<const void*, WolosPerf::SThrottleState> seen;
+    bool                                                       skipChildren = false;
+
     for (const auto& view : Desktop::View::getViewsForWorkspace(pWorkspace)) {
         if (!view->mapped() || !view->acceptsInput() || !view->resource())
             continue;
@@ -2795,8 +2825,53 @@ void IHyprRenderer::sendFrameEventsToWorkspace(PHLMONITOR pMonitor, PHLWORKSPACE
         if (alphaModifier && !alphaModifier->alphaNonZero())
             continue;
 
+        if (view->type() == Desktop::View::VIEW_TYPE_WINDOW) {
+            skipChildren = false;
+            if (CFG.enabled && COUNT > CFG.windowCount) {
+                const auto WPTR = Hyprutils::Memory::dynamicPointerCast<Desktop::View::CWindow>(view);
+                const auto W    = WPTR.get();
+                double     visible = 1.0;
+                if (WolosPerf::coveredByFullscreen(FS != nullptr, FS.get() == W, W->isAllowedOverFullscreen()))
+                    visible = 0.0; // hidden under the fullscreen window
+                else {
+                    const auto               BOX = W->getWindowMainSurfaceBox();
+                    std::vector<WolosPerf::SRect> above;
+                    bool                     after = false;
+                    for (const auto& o : mapped) {
+                        if (o.get() == W) {
+                            after = true;
+                            continue;
+                        }
+                        if (!after || o->m_workspace != pWorkspace)
+                            continue;
+                        // Faded or translucent windows show what is below them.
+                        if (o->presentation().alphaValue(Desktop::View::WINDOW_ALPHA_FADE) != 1.F || o->presentation().alphaValue(Desktop::View::WINDOW_ALPHA_ACTIVE) != 1.F)
+                            continue;
+                        const auto OS = o->wlSurface() ? o->wlSurface()->resource() : nullptr;
+                        const auto OE = OS ? OS->m_current.opaque.getExtents() : CBox{};
+                        const auto OB = o->getWindowMainSurfaceBox();
+                        const auto R  = WolosPerf::occluderRect(WolosPerf::SRect{OB.x, OB.y, OB.w, OB.h}, o->presentation().opaque(), WolosPerf::SRect{OE.x, OE.y, OE.w, OE.h});
+                        if (R.w > 0 && R.h > 0)
+                            above.push_back(R);
+                    }
+                    visible = WolosPerf::visibleFraction(WolosPerf::SRect{BOX.x, BOX.y, BOX.w, BOX.h}, above);
+                }
+                auto& st = m_wolosThrottle[W];
+                skipChildren = !WolosPerf::allowFrameCallback(st, visible, COUNT, elapsedMs, CFG);
+                seen[W]      = st;
+            } else
+                m_wolosThrottle.clear();
+        } else if (view->type() == Desktop::View::VIEW_TYPE_LAYER_SURFACE || view->type() == Desktop::View::VIEW_TYPE_LOCK_SCREEN)
+            skipChildren = false;
+
+        if (skipChildren)
+            continue;
+
         view->wlSurface()->resource()->frame(now);
     }
+
+    if (!seen.empty())
+        m_wolosThrottle = std::move(seen); // drops entries of windows that are gone
 }
 
