# hyprland-wolos: Hyprland 0.57.1 + the WolOS patches (0*.patch here), applied in name order. The 0.57
# series reads only the Lua config (WolOS 0.13 ships hyprland.lua; v0.12.x stays on 0.56.2 with its
# .conf). Packaging follows Arch's hyprland 0.57.1-1. Map: wolos/docs/modules/hyprland-fork.md
pkgname=hyprland-wolos
pkgver=0.57.1
pkgrel=1
pkgdesc='The WolOS window compositor: a tuned fork with the WolOS patches'
arch=(x86_64)
url='https://github.com/hyprwm/Hyprland'
license=(BSD-3-Clause)
depends=(cairo aquamarine libgcc libstdc++ glibc glib2 glslang hyprcursor hyprgraphics
  hyprland-guiutils hyprlang hyprutils hyprwire lcms2 libcanberra libdrm libei libglvnd libinput
  libx11 libxcb libxcomposite libxcursor libxfixes libxkbcommon libxrender lua mesa muparser
  opengl-driver pango pixman re2 sdbus-cpp tomlplusplus util-linux-libs wayland wayland-protocols
  xcb-proto xcb-util xcb-util-errors xcb-util-image xcb-util-keysyms xcb-util-renderutil
  xcb-util-wm xorg-xwayland)
makedepends=(cmake glaze hyprland-protocols hyprwayland-scanner meson ninja xorgproto)
provides=(hyprland="$pkgver" wayland-compositor)
conflicts=(hyprland)
_archive="Hyprland-$pkgver"
# The WolOS patches (0*.patch beside this file, applied in name order) are local sources like any Arch patch.
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
