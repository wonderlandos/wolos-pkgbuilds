# hyprland-wolos: Hyprland 0.56.2 (the snapshot's version) + the WolOS patches (0*.patch here),
# applied in name order. Packaging follows Arch's hyprland 0.56.2-4. Map: wolos/docs/modules/hyprland-fork.md
pkgname=hyprland-wolos
pkgver=0.56.2
pkgrel=4
pkgdesc='Hyprland compositor with the WolOS patches'
arch=(x86_64)
url='https://github.com/hyprwm/Hyprland'
license=(BSD-3-Clause)
depends=(cairo aquamarine libgcc libstdc++ glibc glib2 glslang hyprcursor hyprgraphics
  hyprland-guiutils hyprlang hyprutils hyprwire lcms2 libdrm libglvnd libinput libx11 libxcb
  libxcomposite libxcursor libxfixes libxkbcommon libxrender lua mesa muparser opengl-driver pango
  pixman re2 tomlplusplus util-linux-libs wayland wayland-protocols xcb-proto xcb-util
  xcb-util-errors xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm xorg-xwayland)
makedepends=(cmake glaze hyprland-protocols hyprwayland-scanner meson ninja xorgproto)
provides=(hyprland="$pkgver" wayland-compositor)
conflicts=(hyprland)
_archive="Hyprland-$pkgver"
# The WolOS patches (0*.patch beside this file, applied in name order) are local sources like any Arch patch.
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
