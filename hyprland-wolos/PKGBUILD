prepare() {
  ln -sf hyprland-source "$_archive"
  cd "$_archive"
  local p
  for p in "$srcdir"/0*.patch; do
    echo "WolOS patch: ${p##*/}"
    patch -Np1 < "$p"
  done
  sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
  cd "$_archive"
  # ccache (wolos-build's ccache flag): upstream precompiles headers (CMake -include of the PCH), and
  # ccache passes every call that uses a PCH through uncached (5.9 % cacheable). With this sloppiness
  # it hashes them: pch_defines and time_macros skip checks for macros this build never varies, the
  # include_file_* ones accept headers extracted just before the build.
  export CCACHE_SLOPPINESS=${CCACHE_SLOPPINESS:-pch_defines,time_macros,include_file_mtime,include_file_ctime}
  # Upstream's `make release`, with the jobs makepkg was given (it runs one per core otherwise).
  cmake --no-warn-unused-cli -DCMAKE_SKIP_RPATH=ON -DCMAKE_BUILD_TYPE:STRING=Release \
    -DCMAKE_INSTALL_PREFIX:STRING=/usr -S . -B ./build
  local j
  case " ${MAKEFLAGS:-} " in *' -j'[0-9]*) j=${MAKEFLAGS##*-j}; j=${j%% *} ;; *) j=$(nproc) ;; esac
  cmake --build ./build --config Release --target all -j"$j"
  # The cache's hit rate in the build log (BF-11: was 5.9 % cacheable).
  # makepkg's BUILDENV ccache puts /usr/lib/ccache/bin first on PATH (cache_dir: /etc/ccache.conf).
  case :$PATH: in *:/usr/lib/ccache/bin:*) ccache -s || true ;; esac
}

package() {
  cd "$_archive"
  make DESTDIR="$pkgdir" install
  rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
  find "$pkgdir" -name '*hyprpm*' -delete
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
