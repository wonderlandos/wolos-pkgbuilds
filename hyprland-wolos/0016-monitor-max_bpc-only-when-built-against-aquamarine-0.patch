From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Tue, 3 Nov 2026 14:45:27 +0000
Subject: [PATCH] monitor: max_bpc only when built against aquamarine 0.16

0.57.1 sets the output's max bpc from the monitor rule's bit depth (upstream
#16708), a call aquamarine adds in 0.16; upstream still declares 0.15.0 as its
floor. The WolOS snapshot has 0.15.1, so the call is compiled only against
0.16 or newer and the patch retires itself when the snapshot moves on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/output/Monitor.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index 4b4ef76..868fd80 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -64,6 +64,7 @@
 #include <hyprutils/utils/ScopeGuard.hpp>
 #include <cstring>
 #include <climits>
+#include "../version.h"
 #include <optional>
 #include <ranges>
 #include <vector>
@@ -925,7 +926,10 @@ bool CMonitor::applyMonitorRule(Config::CMonitorRule&& pMonitorRule) {
 
     m_pixelSize = m_size;
 
+    // WolOS: max_bpc needs aquamarine 0.16; built against an older one the output keeps its default.
+#if AQUAMARINE_VERSION_MAJOR > 0 || AQUAMARINE_VERSION_MINOR >= 16
     m_output->state->setMaxBpc(RULE->m_enable10bit ? 10 : 8);
+#endif
 
     static constexpr auto formats10bit = std::to_array<uint32_t>({DRM_FORMAT_XRGB2101010, DRM_FORMAT_XBGR2101010});
     static constexpr auto formats8bit  = std::to_array<uint32_t>({DRM_FORMAT_XRGB8888, DRM_FORMAT_XBGR8888});
