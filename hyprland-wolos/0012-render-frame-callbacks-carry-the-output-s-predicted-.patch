From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:51:27 -0300
Subject: [PATCH] render: frame callbacks carry the output's predicted next
 present time; late-render deadline is misc:frame_deadline of the frame

One floor across outputs keeps the frame clock monotonic for every surface: a
window moved from a 144 Hz to a 60 Hz output never sees its frame time go
back (WolosPerf::monotonicFloor, gtest).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/helpers/WolosPerf.hpp            | 37 ++++++++++++++++++++++++++++
 src/output/Monitor.cpp               |  3 +++
 src/output/Monitor.hpp               |  1 +
 src/output/MonitorFrameScheduler.cpp |  4 ++-
 src/render/Renderer.cpp              |  8 +++++-
 tests/helpers/WolosPerf.cpp          | 30 ++++++++++++++++++++++
 6 files changed, 81 insertions(+), 2 deletions(-)

diff --git a/src/helpers/WolosPerf.hpp b/src/helpers/WolosPerf.hpp
index 25f20f2..390018d 100644
--- a/src/helpers/WolosPerf.hpp
+++ b/src/helpers/WolosPerf.hpp
@@ -4,6 +4,7 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cmath>
 #include <vector>
 
 namespace WolosPerf {
@@ -156,4 +157,40 @@ namespace WolosPerf {
             return std::max(1.0, timeoutMs - (nowMs - startMs));
         }
     };
+
+    // Per-output present prediction from presentation feedback. Frame callbacks carry the predicted next present
+    // time (monotonic per output), so client animations advance to what will be on screen.
+    struct SPresentPredictor {
+        double lastPresentMs = 0; // last reported present time
+        double intervalMs    = 0; // reported refresh interval
+        double lastGivenMs   = 0;
+
+        void   onPresented(double presentMs, double refreshIntervalMs) {
+            lastPresentMs = presentMs;
+            intervalMs    = refreshIntervalMs;
+        }
+        // First present strictly after `nowMs`; `nowMs` itself when no feedback arrived yet.
+        double next(double nowMs) {
+            double t = nowMs;
+            if (intervalMs > 0.5 && lastPresentMs > 0) {
+                const double n = std::floor((nowMs - lastPresentMs) / intervalMs) + 1;
+                t              = lastPresentMs + std::max(0.0, n) * intervalMs;
+            }
+            t           = std::max(t, lastGivenMs);
+            lastGivenMs = t;
+            return t;
+        }
+    };
+
+    // Predictions are per output; a surface moved from a 144 Hz to a 60 Hz output could see its frame clock go back.
+    // One floor for every output keeps frame times monotonic for every surface.
+    inline double monotonicFloor(double& floorMs, double predictedMs) {
+        floorMs = std::max(floorMs, predictedMs);
+        return floorMs;
+    }
+
+    // A render that has taken longer than this share of the frame interval counts as late.
+    inline bool renderMissedDeadline(double renderedMs, float refreshHz, double deadline) {
+        return refreshHz > 0 && renderedMs >= deadline * 1000.0 / refreshHz;
+    }
 }
