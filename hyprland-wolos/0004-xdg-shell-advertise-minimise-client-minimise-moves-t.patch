From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kleeedolinux <71413974+kleeedolinux@users.noreply.github.com>
Date: Mon, 26 Oct 2026 08:20:43 -0300
Subject: [PATCH] xdg-shell: advertise minimise; client minimise moves the
 window to special:hidden

---
 src/desktop/view/window/Window.cpp | 4 ++++
 src/protocols/XDGShell.cpp         | 3 +++
 2 files changed, 7 insertions(+)

diff --git a/src/desktop/view/window/Window.cpp b/src/desktop/view/window/Window.cpp
index 881b5f7..5f3b7b1 100644
--- a/src/desktop/view/window/Window.cpp
+++ b/src/desktop/view/window/Window.cpp
@@ -839,6 +839,10 @@ void CWindow::activate(bool force) {
 }
 
 void CWindow::onUpdateState(const SBackendStateRequest& request) {
+    // WolOS: client minimise (CSD button) hides the window like the Minimise menu item.
+    if (request.minimized.value_or(false) && m_isMapped && m_backend && !m_backend->isX11())
+        Config::Actions::moveToWorkspace("special:hidden", true, m_self.lock());
+
     requestClientFullscreen({
         .fullscreen        = request.fullscreen,
         .maximized         = request.maximized,
diff --git a/src/protocols/XDGShell.cpp b/src/protocols/XDGShell.cpp
index 22371d7..66f5ea6 100644
--- a/src/protocols/XDGShell.cpp
+++ b/src/protocols/XDGShell.cpp
@@ -173,6 +173,9 @@ CXDGToplevelResource::CXDGToplevelResource(SP<CXdgToplevel> resource_, SP<CXDGSu
         *p     = XDG_TOPLEVEL_WM_CAPABILITIES_FULLSCREEN;
         p      = sc<uint32_t*>(wl_array_add(&arr, sizeof(uint32_t)));
         *p     = XDG_TOPLEVEL_WM_CAPABILITIES_MAXIMIZE;
+        // WolOS: minimise is real (the window goes to special:hidden), so clients enable their button.
+        p  = sc<uint32_t*>(wl_array_add(&arr, sizeof(uint32_t)));
+        *p = XDG_TOPLEVEL_WM_CAPABILITIES_MINIMIZE;
         m_resource->sendWmCapabilities(&arr);
         wl_array_release(&arr);
     }
