# wolos-module-creative (ADR 0032, wolos docs/modules/modules.md): the "Creative" optional module.
# A meta package: depends= is wolos-system plus the `packages` of its registry record
# (/usr/share/wolos/modules/creative.json, shipped by wolos-system so the module is listed before it is
# installed; checks/tests/modules.rs keeps the two equal). Everything is a snapshot-pinned Arch
# package; nothing outside Arch is a dependency. User side (`wol modules enable creative`):
# nothing yet.
# Not on the ISO and never pre-ticked. Built with makepkg --nodeps (./build.conf): it builds nothing.
pkgname=wolos-module-creative
pkgver=0.12.0
pkgrel=3
pkgdesc='WolOS Creative module: Blender, GIMP, Krita, Inkscape, OBS, darktable, Kdenlive, Ardour, Audacity'
arch=(any)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
depends=(wolos-system blender gimp krita inkscape obs-studio darktable kdenlive ardour audacity
  colord pipewire-jack gst-plugin-pipewire wolos-hue)

package() {
  # Nothing to install: the dependencies are the module.
  :
}
