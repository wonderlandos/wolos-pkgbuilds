# Text files are stored and checked out with LF, whatever the platform, so a diff shows only real
# changes and the sha256sums of a recipe's local sources match on every checkout.
* text=auto eol=lf
# Bytes that must never be converted: patches applied to other trees (upstream files may carry
# CRLF hunks), keys and keyring lists (fingerprints and signatures cover the exact bytes), images.
*.patch -text
*.asc -text
*.gpg -text
*.sig -text
wolos-keyring/*-trusted -text
*.png binary
*.zst binary
