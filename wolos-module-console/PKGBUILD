# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-module-console (ADR 0032, wolos docs/modules/modules.md): the "Console" optional module.
# A meta package: depends= is wolos-system plus the `packages` of its registry record
# (/usr/share/wolos/modules/console.json, shipped by wolos-system so the module is listed before it is
# installed; checks/tests/modules.rs keeps the two equal). Everything is a snapshot-pinned Arch
# package; nothing outside Arch is a dependency. User side (`wol modules enable console`):
# PowerShell (wopkg recipe powershell).
# Not on the ISO and never pre-ticked. Built with makepkg --nodeps (./build.conf): it builds nothing.
pkgname=wolos-module-console
pkgver=0.12.0
pkgrel=2
pkgdesc='WolOS Console module: starship, fzf, zoxide, eza, bat, fd, ripgrep, fish, nushell, ghostty, kitty'
arch=(any)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
depends=(wolos-system starship fzf zoxide eza bat fd ripgrep fish nushell zellij ghostty kitty)

package() {
  # Nothing to install: the dependencies are the module.
  :
}
