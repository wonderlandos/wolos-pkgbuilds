# SPDX-License-Identifier: GPL-2.0-or-later
# UAPI headers from the same WolKernel tag as linux-wolos (ADR 0017): replaces Arch's linux-api-headers.
# _wk/_linux must equal ../linux-wolos/VERSION (makepkg reads only this directory in a clean chroot;
# lint.sh checks the two agree).
pkgname=linux-wolos-api-headers
# Version: linux-wolos/VERSION (pkgver = <wolkernel>+<linux>; epoch 1 sorts it above the old 7.3.0).
_wk=1.1
_linux=7.3
epoch=1
pkgver=$_wk+$_linux
pkgrel=1
_tag=wolkernel-$_wk-$_linux  # TODO(main): created by the kernel worker
pkgdesc="Kernel headers sanitized for use in userspace (WolKernel $_wk ($_linux))"
arch=(any)
url='https://github.com/wonderlandos/linux'
license=(GPL-2.0-only)
makedepends=(git rsync)
provides=("linux-api-headers=$_linux")
conflicts=(linux-api-headers)
replaces=(linux-api-headers)
source=("linux::git+https://github.com/wonderlandos/linux.git#tag=$_tag")
sha256sums=(SKIP)

build() {
  cd linux
  make mrproper
}

package() {
  cd linux
  make INSTALL_HDR_PATH="$pkgdir/usr" headers_install
  # libdrm ships the drm headers (as on Arch).
  rm -r "$pkgdir/usr/include/drm"
}
