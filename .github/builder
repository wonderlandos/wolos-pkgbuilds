#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# builder CMD [ARG...]: run CMD in the wolos-build builder image (the private tool, no checkout of
# wonderlandos/wolos-build; `wolos-build` is on its PATH). The image is .github/builder-image, the one
# place its tag is pinned. Needs `docker login` to its ECR registry first (aws-actions/amazon-ecr-login
# after the OIDC credentials). The workspace is mounted at the same path, CMD runs in the current
# directory as the runner's user, and the AWS, cluster, WolOS, GitHub and key variables pass through.
# The runner only dispatches, signs and publishes: `wolos-build pkg|iso --ecs` builds on the cluster.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
img=$(tr -d '[:space:]' < "$here/builder-image")
ws=${GITHUB_WORKSPACE:-$PWD}
env=()
for v in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_REGION AWS_DEFAULT_REGION \
  CLUSTER TASK_DEF TASK_DEF_ISO CAPACITY BUCKET GH_REPO GH_TOKEN GPG_KEY \
  $(compgen -e | grep '^WOLOS_' || true); do
  env+=(-e "$v")
done
gh=()
if command -v gh >/dev/null; then gh=(-v "$(command -v gh):/usr/local/bin/gh:ro"); fi
exec docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp/home -v "$ws:$ws" -w "$PWD" \
  "${gh[@]}" "${env[@]}" --entrypoint /usr/bin/env "$img" sh -c 'mkdir -p "$HOME" && exec "$@"' builder "$@"
