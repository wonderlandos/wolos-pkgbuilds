# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-mirrorlist: where pacman finds [wolos] (wolos-mirrorlist, dated: the release's snapshot,
# wolos-iso/profile/snapshot; `wol update` moves it, `wol mirror rank` reorders it) and the gated
# CachyOS x86-64-v3 repos (wolos-cachy-mirrorlist: the CDN's /cachy/ redirect, no date). ADR 0030.
# REPO_DOMAIN in both files is the CloudFront domain; set it once (pkgrel bump) after terraform apply.
pkgname=wolos-mirrorlist
pkgver=2026.10.31
pkgrel=2
pkgdesc='WolOS package mirror list'
arch=(any)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
backup=(etc/pacman.d/wolos-mirrorlist etc/pacman.d/wolos-cachy-mirrorlist)
source=(wolos-mirrorlist wolos-cachy-mirrorlist)
sha256sums=('e65aa14757a652ccab1b9f5af6d746a675390d01f0e710cc2650f668e13f4e11'
            '45d7030ea5f19949edec1f941b75c869048504c4b917310c73468a8599472651')

package() {
  install -Dm644 wolos-mirrorlist "$pkgdir/etc/pacman.d/wolos-mirrorlist"
  install -Dm644 wolos-cachy-mirrorlist "$pkgdir/etc/pacman.d/wolos-cachy-mirrorlist"
}
