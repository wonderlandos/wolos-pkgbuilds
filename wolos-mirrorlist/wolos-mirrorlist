# WolOS mirrors for [wolos] at release 2026-10-31 ($repo = the repo name; ADR 0030).
# `wol mirror rank` orders them by latency; `wol update` moves the date with each release.
# Primary: the WolOS CDN (CloudFront in front of the wolos-repo bucket, <tag>/<file>; it falls back
# to the release assets on its own). REPO_DOMAIN is the CloudFront domain (wolos-build infra:
# `terraform output repo_domain`), set once with a pkgrel bump; until then pacman fails over to the next line.
Server = https://REPO_DOMAIN/$repo-2026-10-31
# Fallback: the release assets of github.com/wonderlandos/wolos-packages.
Server = https://github.com/wonderlandos/wolos-packages/releases/download/$repo-2026-10-31
