# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-system: everything WolOS adds to the Arch base, from github.com/wonderlandos/wolos: the Rust
# binaries (tools/build-rust.sh), Hyprland plugins (desktop/hyprland/build-plugins.sh), desktop/overlay,
# files/ (systemd units, installer, helpers) and design (icons, wallpapers, illustrations).
pkgname=wolos-system
pkgver=0.12.1  # the newest CHANGELOG.md entry at _wolos_commit
pkgrel=5
pkgdesc='WolOS system services, shell and desktop defaults'
arch=(x86_64)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later CC-BY-NC-ND-4.0)
# plymouth: installed first, so post_install can make the WolOS splash the theme.
# nftables: etc/wolos/nftables.conf runs nft; libnautilus-extension: the Files "Analyze with ClamAV"
# extension (usr/lib/nautilus/extensions-4/libwolos-analyze.so) links it. arch-audit: the CVE list
# usr/lib/wolos/update-check writes (Settings > Updates, Security); without it that list is absent.
# networkmanager-openvpn + openvpn: Settings > Network > Add VPN and `wol vpn import` of .ovpn files
# (NET-3; NetworkManager's OpenVPN plugin, about 5 MiB installed).
depends=(hyprland-wolos gtk4 gtk4-layer-shell libadwaita pam systemd clamav plymouth nftables
  libnautilus-extension arch-audit networkmanager-openvpn openvpn)
# Our cursor theme is the default one (usr/share/icons/default).
provides=(default-cursors)
conflicts=(default-cursors)
replaces=(default-cursors)
# python: design/tools/east/walls.py generates the Moon Gate in every theme's dye (_east_walls_build).
makedepends=(cargo clang mold sccache pkgconf hyprland-wolos git nautilus pipewire python)
options=(!debug !lto)
backup=(etc/sudoers etc/wolos/shell.json etc/sudoers.d/wolos etc/pam.d/wol-login etc/wolos/nftables.conf etc/wolos/nftables.d/ssh.conf etc/wolos/nftables.d/airplay.conf
  etc/zsh/zshenv etc/zellij/config.kdl etc/mise/config.toml etc/fish/conf.d/wolos.fish
  etc/profile.d/wolos-console.sh etc/profile.d/wolos-ime.sh)
install=wolos-system.install
# The WolOS source at one commit (bumped by bump-wolos.sh from wolos CI), with its submodules.
_wolos_commit=88702475bef751c0978d5e97d5758c803bf570e3
# The submodule commits recorded in wolos at _wolos_commit (bump-wolos.sh keeps them in step).
_brand_commit=097d2e6ae8bbdc579313914cd6ddda9348d7fe6d
_shell_commit=1df996a17f2fee489fc89bba1c80cb63f64ff3fb
# Image defaults the code relies on, kept here until wolos files/ carries them (same install paths):
# ntsync at boot (Games Doctor), the CJK/Arabic/Hebrew font fallbacks (language picker, terminal),
# power-profiles-daemon on (Energy Mode), .local names through nss-mdns (Printers, AirPlay, sharing).
source=("wolos::git+https://github.com/wonderlandos/wolos.git#commit=$_wolos_commit"
  "wolos-brand::git+https://github.com/wonderlandos/wolos-brand.git#commit=$_brand_commit"
  "wolos-shell::git+https://github.com/wonderlandos/wolos-shell.git#commit=$_shell_commit"
  ntsync.conf 70-wolos-cjk-arabic.conf 51-wolos-image.preset nsswitch-mdns.sh)
sha256sums=(SKIP SKIP SKIP
            '35472b5aa171de5251b78f19df9940d62c15fe533f5d5873151daf2713a1d6ca'
            '0f3d50026713eefc2a05cb43d5a114de1bd6a858f1cd358a8c476de389e7040f'
            '500e3b21ef6b3d16352f55afaf52d68c8d5613869de05c53860ef727b37592d8'
            'e92161b6ce50b2e3540f0118e3ba35b95a0de73a3f7d3049e20eaf1405946704')

prepare() {
  cd "$srcdir/wolos"
  git submodule init
  git config submodule.design.url "$srcdir/wolos-brand"
  git config submodule.crates/shell.url "$srcdir/wolos-shell"
  git -c protocol.file.allow=always submodule update
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

# The east wallpapers (design east/wallpapers/README.md): the Moon Gate in each built-in theme's dye,
# generated from the theme files (not in git; 23 themes x day/night x 4k/16:10, ~1 s, ~133 MB of SVG
# text), and its parameter set, which the desktop's day/night and theme transition reads
# (shell kit/gate.rs). $1: the wolos tree; $2: the staging directory.
_east_walls_build() {
  local d=$1/design e=$2
  [ -f "$d/tools/east/walls.py" ] || return 0
  rm -rf "$e"
  install -d "$e/themes"
  WOLOS_THEMES="$1/crates/core/src/theme/builtin" python3 -I "$d/tools/east/walls.py" themes siggate --out "$e/themes"
  python3 -I "$d/tools/east/walls.py" gate --params --out "$e/wolos-gate.params.json"
}

# The shipped gate (signature dye), Cachoeira Station and the earlier places when present, and what
# _east_walls_build made, into usr/share/wolos/wallpapers. $1: the wolos tree; $2: staging; $3: pkgdir.
_east_walls_package() {
  local w=$1/design/east/wallpapers e=$2 p
  [ -d "$e" ] || return 0
  local wp=$3/usr/share/wolos/wallpapers
  install -d "$wp/themes"
  install -m644 -t "$wp" "$w"/wolos-gate-{day,night}-{4k,16x10}.svg "$e/wolos-gate.params.json"
  install -m644 -t "$wp/themes" "$e"/themes/gate-*.svg
  for p in cachoeira brasilia estaiada rioniteroi; do
    [ ! -f "$w/$p-day-4k.svg" ] || install -m644 -t "$wp" "$w/$p"-{day,night}-{4k,16x10}.svg
  done
}

build() {
  local _repo=$srcdir/wolos
  _east_walls_build "$_repo" "$srcdir/east-walls"
  export CARGO_TARGET_DIR=$srcdir/target
  "$_repo/tools/build-rust.sh" "$srcdir/stage"
  "$_repo/desktop/hyprland/build-plugins.sh" "$srcdir/stage"
  # build-rust.sh compiles through sccache (a makedepend; SCCACHE_DIR from wolos-build): its hit rate.
  if command -v sccache >/dev/null; then sccache --show-stats || true; fi
  # The stage has usr/local/bin/pacman (build-rust.sh: the sealed system's pacman, first on PATH,
  # runs the real /usr/bin/pacman; ADR 0016). namcap flags /usr/local; kept, as published.
}

package() {
  local _repo=$srcdir/wolos
  cp -a "$srcdir/stage/." "$pkgdir/"
  (cd "$_repo/desktop/overlay" && tar --exclude ./usr/local -cf - .) | tar -C "$pkgdir" --no-same-owner -xf -
  (cd "$_repo/files" && cp -a --no-preserve=ownership . "$pkgdir/")
  rm "$pkgdir/usr/share/wolos/os-release"   # wolos-base owns it
  # The plugin manifest schema where crates/shared/src/plugins.rs SCHEMA_PATH and ADR 0031 say it is.
  install -Dm644 "$_repo/docs/plugins/plugin.schema.json" "$pkgdir/usr/share/wolos/plugins.schema.json"
  install -Dm644 "$srcdir/ntsync.conf" "$pkgdir/usr/lib/modules-load.d/ntsync.conf"
  install -Dm644 "$srcdir/70-wolos-cjk-arabic.conf" "$pkgdir/etc/fonts/conf.d/70-wolos-cjk-arabic.conf"
  install -Dm644 "$srcdir/51-wolos-image.preset" "$pkgdir/usr/lib/systemd/system-preset/51-wolos-image.preset"
  install -Dm755 "$srcdir/nsswitch-mdns.sh" "$pkgdir/usr/lib/wolos/nsswitch-mdns"
  local d=$_repo/design
  [ ! -d "$d/icons" ] || sh "$d/icons/install.sh" "$pkgdir/usr/share/icons/WolOS"
  [ ! -d "$d/wallpapers" ] || { install -d "$pkgdir/usr/share/wolos/wallpapers"; cp -R "$d/wallpapers/." "$pkgdir/usr/share/wolos/wallpapers/"; }
  _east_walls_package "$_repo" "$srcdir/east-walls" "$pkgdir"
  [ ! -d "$d/tokens" ] || { install -d "$pkgdir/usr/share/wolos/tokens"; cp -R "$d/tokens/." "$pkgdir/usr/share/wolos/tokens/"; }
  [ ! -d "$d/icons/store" ] || install -Dm644 -t "$pkgdir/usr/share/wolos/store-icons" "$d"/icons/store/*.svg
  [ ! -f "$d/brand/wolos-splash.png" ] || install -Dm644 "$d/brand/wolos-splash.png" "$pkgdir/usr/share/plymouth/themes/wolos/wolos.png"
  local a f
  for a in setup-welcome white-rabbit keyhole pocket-watch cheshire teacup lock-peek; do
    for f in "$d/illustrations/png/$a"@*.png; do
      [ ! -f "$f" ] || install -Dm644 -t "$pkgdir/usr/share/wolos/illustrations" "$f"
    done
  done
  chmod 440 "$pkgdir/etc/sudoers"
  chmod 440 "$pkgdir/etc/sudoers.d/wolos"
  chmod 755 "$pkgdir"/usr/lib/wolos/* "$pkgdir"/usr/bin/*
  # polkit reads rules only from a directory polkitd can read and others cannot: the same owner and
  # mode Arch's polkit package gives it (root:102 = polkitd, 0750), so pacman sees no conflict.
  if [ -d "$pkgdir/usr/share/polkit-1/rules.d" ]; then
    chmod 750 "$pkgdir/usr/share/polkit-1/rules.d"
    chown root:102 "$pkgdir/usr/share/polkit-1/rules.d"
    chmod 644 "$pkgdir"/usr/share/polkit-1/rules.d/*.rules
  fi
  # Rust and GPL-3.0 shell licenses travel with the package.
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_repo/docs/THIRD-PARTY.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}
