# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-base (ADR 0017): WolKernel + its UAPI headers + the base userland at one WolOS release.
# Non-GNU tools take the GNU names (uutils coreutils, sudo-rs) and stand in for the GNU packages
# through provides/conflicts, so `base`, `base-devel` and everything that depends on coreutils or
# sudo still resolve. glibc, gcc-libs and bash stay (Steam, Proton, NVIDIA; Arch hooks need bash).
# GNU findutils, diffutils and tar stay too: no uutils findutils/diffutils at the snapshot, and
# pacman/dkms scripts use GNU tar options (bsdtar is shipped and preferred by makepkg/mkinitcpio).
# Ships /usr/share/wolos/base.manifest (sha256 + path of every base file: ./base.manifest, written by
# ./prebuild.sh before the build; wolos-build runs it) and the os-release of this release.
# Built with makepkg --nodeps (./build.conf): its depends are the installed system's, nothing it builds
# with, and wolos-system's /etc/sudoers clashes with the chroot's sudo.
pkgname=wolos-base
pkgver=0.12.0  # the newest CHANGELOG.md entry at _wolos_commit
pkgrel=1
pkgdesc='WolOS base system: kernel, headers and userland of one release'
arch=(x86_64)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
depends=('base' 'linux-wolos' 'linux-wolos-headers' 'linux-wolos-api-headers' 'uutils-coreutils'
  'sudo-rs' 'libarchive' 'zsh' 'systemd' 'wolos-system' 'glibc' 'gcc-libs' 'bash')
# linux-wolos builds vboxguest, vboxsf and vboxvideo (virtualbox-guest-utils asks for them).
provides=('coreutils=9.12' 'sudo' 'VIRTUALBOX-GUEST-MODULES')
conflicts=('coreutils' 'sudo')
backup=()
install=wolos-base.install
# os-release comes from the WolOS source (files/usr/share/wolos/os-release) at one commit, as one
# file with its checksum (bump-wolos.sh moves both): no git, which --nodeps would not install.
_wolos_commit=968ab4f4d39adfdeb73c0c9b1e84a3c8244105e6
_os_release_sha256=1345cbb2d23dbb57949c6751baca359cf256b1e207941a194ba9fb6855cd46c9
source=("os-release-$_wolos_commit::https://raw.githubusercontent.com/wonderlandos/wolos/$_wolos_commit/files/usr/share/wolos/os-release"
  wolos-os-release.hook base.manifest)
sha256sums=("$_os_release_sha256"
            '6482e332e9e062e901cc297495395ef255baa9aa99b49b6cc6e29b4c8d327d10'
            SKIP) # base.manifest: written by prebuild.sh at build time (tools/lint.sh exception)

# GNU coreutils 9.12 program names; uutils-coreutils ships each as uu-<name>.
_coreutils=('[' b2sum base32 base64 basename basenc cat chgrp chmod chown chroot cksum comm cp csplit
  cut date dd df dir dircolors dirname du echo env expand expr factor false fmt fold groups head hostid
  id install join link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup nproc numfmt od
  paste pathchk pinky pr printenv printf ptx pwd readlink realpath rm rmdir seq sha1sum sha224sum
  sha256sum sha384sum sha512sum shred shuf sleep sort split stat stdbuf stty sum sync tac tail tee test
  timeout touch tr true truncate tsort tty uname unexpand uniq unlink users vdir wc who whoami yes)

package() {
  local b
  install -d "$pkgdir/usr/bin"
  for b in "${_coreutils[@]}"; do
    ln -s "uu-$b" "$pkgdir/usr/bin/$b"
  done
  for b in sudo sudoedit visudo; do
    ln -s "$b-rs" "$pkgdir/usr/bin/$b"
  done
  # os-release of this release: /etc/os-release is written from it by the hook (filesystem owns
  # /usr/lib/os-release and the /etc symlink).
  sed "s/@VERSION@/$pkgver/g" "$srcdir/os-release-$_wolos_commit" | install -Dm644 /dev/stdin "$pkgdir/usr/share/wolos/os-release"
  install -Dm644 "$srcdir/wolos-os-release.hook" "$pkgdir/usr/share/libalpm/hooks/wolos-os-release.hook"
  echo "$pkgver" | install -Dm644 /dev/stdin "$pkgdir/usr/share/wolos/base.version"
  # Manifest last: it hashes the base packages and this package's own files.
  {
    cat "$srcdir/base.manifest"
    (cd "$pkgdir" && find . \( -type f -o -type l \) -printf '%P\n' | LC_ALL=C sort | while IFS= read -r f; do
      if [ -L "$f" ]; then s=$(readlink "$f" | sha256sum); else s=$(sha256sum < "$f"); fi
      printf '%s  /%s\n' "${s%% *}" "$f"
    done)
  } | LC_ALL=C sort -k2 | install -Dm644 /dev/stdin "$pkgdir/usr/share/wolos/base.manifest"
}
