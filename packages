# The [wolos] repo, one package per line in build order: NAME DIR LOCAL-DEPS(comma, - for none) PATHS...
# DIR is this repo's directory for NAME (its PKGBUILD). LOCAL-DEPS are [wolos] packages the build
# installs (makechrootpkg -I) or reads (prebuild.sh). PATHS are the paths (prefixes) here whose change
# rebuilds NAME; `wolos-build pkg --changed REV` adds every package that depends on a rebuilt one.
# Code from github.com/wonderlandos/wolos reaches a package only through its pinned _wolos_commit,
# so a change there is a change of the package directory (bump-wolos.sh).
linux-wolos    linux-wolos          -                                       linux-wolos/
linux-wolos-v3 linux-wolos          -                                       linux-wolos/
linux-wolos-api-headers linux-wolos-api-headers -                         linux-wolos-api-headers/ linux-wolos/VERSION
hyprland-wolos hyprland-wolos       -                                       hyprland-wolos/
flatpak-wolos  flatpak-wolos        -                                       flatpak-wolos/
helium-browser helium-browser       -                                       helium-browser/
wolos-mirrorlist wolos-mirrorlist   -                                       wolos-mirrorlist/ snapshot
wolos-system   wolos-system         hyprland-wolos                          wolos-system/
wopkg          wopkg                -                                       wopkg/
libwol         libwol               -                                       libwol/
libwolkit      libwolkit            -                                       libwolkit/
webengine-wolos webengine-wolos     -                                       webengine-wolos/
cryswol        cryswol              libwol                                  cryswol/
wolkit         wolkit               libwolkit,libwol,cryswol                wolkit/
wolos-hue      wolos-hue            -                                       wolos-hue/
wolos-shim     wolos-shim           -                                       wolos-shim/
wolos-keyring  wolos-keyring        -                                       wolos-keyring/
obs-pipewire-audio-capture obs-pipewire-audio-capture -                 obs-pipewire-audio-capture/
wolos-base     wolos-base           linux-wolos,linux-wolos-api-headers,hyprland-wolos,wolos-system  wolos-base/ snapshot pacman.conf
# Optional modules (ADR 0032): meta packages, depends only; not in the image (wolos-iso), installed by
# install-run, firstboot or `wol modules install`.
wolos-module-ai-claude wolos-module-ai-claude -                      wolos-module-ai-claude/
wolos-module-ai-local wolos-module-ai-local -                        wolos-module-ai-local/
wolos-module-ai-sessions wolos-module-ai-sessions -                  wolos-module-ai-sessions/
wolos-module-console wolos-module-console -                          wolos-module-console/
wolos-module-creative wolos-module-creative -                        wolos-module-creative/
wolos-module-dev wolos-module-dev -                                  wolos-module-dev/
wolos-module-gaming wolos-module-gaming -                            wolos-module-gaming/
