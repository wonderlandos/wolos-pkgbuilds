# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-browser-config: browser defaults and theme loader. Not in the image and not in packages.
pkgname=wolos-browser-config
pkgver=1
pkgrel=13
pkgdesc='WolOS browser defaults'
arch=(any)
url='https://github.com/wonderlandos/wolos'
license=(GPL-2.0-or-later)
# The files live with the code that generates and tests them: wolos desktop/browser-config.
_wolos_commit=c04d276d7140c7e0122b34ed16c3e55b52e0f013
source=("wolos::git+https://github.com/wonderlandos/wolos.git#commit=$_wolos_commit")
sha256sums=(SKIP)
makedepends=(git)

package() {
  cd "$srcdir/wolos/desktop/browser-config"
  install -Dm644 wolos.cfg "$pkgdir/usr/lib/firefox/wolos.cfg"
  install -Dm644 autoconfig.js "$pkgdir/usr/lib/firefox/defaults/pref/autoconfig.js"
  install -Dm644 policies.json "$pkgdir/usr/lib/firefox/distribution/policies.json"
}
